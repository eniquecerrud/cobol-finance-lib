>>SOURCE FORMAT FREE
*> Arnés COBOL: casos exactos en punto fijo, sin tolerancia flotante.
IDENTIFICATION DIVISION.
PROGRAM-ID. fin-humo.

ENVIRONMENT DIVISION.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "fin-estado.cpy".
COPY "fin-potencia.cpy".
COPY "fin-interes.cpy".
COPY "fin-anualidad.cpy".
COPY "fin-prestamo.cpy".
COPY "fin-vpn-tir.cpy".
COPY "fin-depreciacion.cpy".

01 WS-OK                     PIC 9(4) VALUE 0.
01 WS-FALLOS                 PIC 9(4) VALUE 0.
01 WS-N                      PIC 9(4) VALUE 0.
01 WS-SUMA-CAP               PIC S9(13)V9(6) COMP-3.
01 WS-K                      PIC 9(5) COMP-5.
01 WS-NOMBRE                 PIC X(60).

PROCEDURE DIVISION.
0000-MAIN.
    PERFORM 0100-POTENCIA
    PERFORM 0200-INTERES
    PERFORM 0300-ANUALIDAD
    PERFORM 0400-PRESTAMO
    PERFORM 0500-VPN-TIR
    PERFORM 0600-DEPRECIACION
    DISPLAY "PRUEBAS COBOL: " WS-OK " OK, " WS-FALLOS " FALLOS"
    MOVE WS-FALLOS TO RETURN-CODE
    STOP RUN.

0100-POTENCIA.
    INITIALIZE FP-PARAMS
    MOVE "POWI" TO FP-OPERACION
    MOVE 2 TO FP-BASE
    MOVE 10 TO FP-EXPONENTE
    CALL "fin-potencia" USING FP-PARAMS
    MOVE "2 ** 10 = 1024" TO WS-NOMBRE
    IF FP-CODIGO = FIN-OK AND FP-RESULTADO = 1024
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FP-PARAMS
    MOVE "POWI" TO FP-OPERACION
    MOVE 2 TO FP-BASE
    MOVE -1 TO FP-EXPONENTE
    CALL "fin-potencia" USING FP-PARAMS
    MOVE "2 ** -1 = 0.5" TO WS-NOMBRE
    IF FP-CODIGO = FIN-OK AND FP-RESULTADO = 0.5
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FP-PARAMS
    MOVE "POWI" TO FP-OPERACION
    MOVE 0 TO FP-BASE
    MOVE 5 TO FP-EXPONENTE
    CALL "fin-potencia" USING FP-PARAMS
    MOVE "0 ** 5 = 0" TO WS-NOMBRE
    IF FP-CODIGO = FIN-OK AND FP-RESULTADO = 0
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FP-PARAMS
    MOVE "POWI" TO FP-OPERACION
    MOVE 5 TO FP-BASE
    MOVE 0 TO FP-EXPONENTE
    CALL "fin-potencia" USING FP-PARAMS
    MOVE "5 ** 0 = 1" TO WS-NOMBRE
    IF FP-CODIGO = FIN-OK AND FP-RESULTADO = 1
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FP-PARAMS
    MOVE "RAIZ" TO FP-OPERACION
    MOVE 1.21 TO FP-BASE
    MOVE 2 TO FP-EXPONENTE
    CALL "fin-potencia" USING FP-PARAMS
    MOVE "raiz cuadrada de 1.21" TO WS-NOMBRE
    IF FP-CODIGO = FIN-OK AND FP-RESULTADO = 1.1
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF
    .

0200-INTERES.
    INITIALIZE FI-PARAMS
    MOVE "SIMP" TO FI-OPERACION
    MOVE 1000 TO FI-CAPITAL
    MOVE 0 TO FI-TASA
    MOVE 5 TO FI-TIEMPO
    CALL "fin-interes" USING FI-PARAMS
    MOVE "simple tasa cero" TO WS-NOMBRE
    IF FI-CODIGO = FIN-OK AND FI-INTERES = 0 AND FI-VALOR-FUTURO = 1000
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FI-PARAMS
    MOVE "SIMP" TO FI-OPERACION
    MOVE 1000 TO FI-CAPITAL
    MOVE 0.08 TO FI-TASA
    MOVE 2 TO FI-TIEMPO
    CALL "fin-interes" USING FI-PARAMS
    MOVE "simple 1000 * 0.08 * 2" TO WS-NOMBRE
    IF FI-CODIGO = FIN-OK AND FI-INTERES = 160
        AND FI-VALOR-FUTURO = 1160
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FI-PARAMS
    MOVE "COMP" TO FI-OPERACION
    MOVE 1000 TO FI-CAPITAL
    MOVE 0.05 TO FI-TASA
    MOVE 1 TO FI-PERIODOS
    CALL "fin-interes" USING FI-PARAMS
    MOVE "compuesto un periodo" TO WS-NOMBRE
    IF FI-CODIGO = FIN-OK AND FI-VALOR-FUTURO = 1050
        AND FI-INTERES = 50
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FI-PARAMS
    MOVE "COMP" TO FI-OPERACION
    MOVE 1000 TO FI-CAPITAL
    MOVE 0 TO FI-TASA
    MOVE 10 TO FI-PERIODOS
    CALL "fin-interes" USING FI-PARAMS
    MOVE "compuesto tasa cero" TO WS-NOMBRE
    IF FI-CODIGO = FIN-OK AND FI-VALOR-FUTURO = 1000
        AND FI-INTERES = 0
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FI-PARAMS
    MOVE "COMP" TO FI-OPERACION
    MOVE 1000 TO FI-CAPITAL
    MOVE -1 TO FI-TASA
    MOVE 2 TO FI-PERIODOS
    CALL "fin-interes" USING FI-PARAMS
    MOVE "compuesto tasa -1" TO WS-NOMBRE
    IF FI-CODIGO = FIN-ERR-TASA
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FI-PARAMS
    MOVE "VPRE" TO FI-OPERACION
    MOVE 1050 TO FI-VALOR-FUTURO
    MOVE 0.05 TO FI-TASA
    MOVE 1 TO FI-PERIODOS
    CALL "fin-interes" USING FI-PARAMS
    MOVE "valor presente un periodo" TO WS-NOMBRE
    IF FI-CODIGO = FIN-OK AND FI-VALOR-PRESENTE = 1000
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FI-PARAMS
    MOVE "EFEC" TO FI-OPERACION
    MOVE 0.12 TO FI-TASA
    MOVE 1 TO FI-CAPITALIZACIONES
    CALL "fin-interes" USING FI-PARAMS
    MOVE "efectiva con m = 1" TO WS-NOMBRE
    IF FI-CODIGO = FIN-OK AND FI-TASA-SALIDA = 0.12
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF
    .

0300-ANUALIDAD.
    INITIALIZE FA-PARAMS
    MOVE "PVAN" TO FA-OPERACION
    MOVE "O" TO FA-TIPO
    MOVE 100 TO FA-CUOTA
    MOVE 0 TO FA-TASA
    MOVE 10 TO FA-PERIODOS
    CALL "fin-anualidad" USING FA-PARAMS
    MOVE "anualidad tasa cero" TO WS-NOMBRE
    IF FA-CODIGO = FIN-OK AND FA-VALOR-PRESENTE = 1000
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FA-PARAMS
    MOVE "PVAN" TO FA-OPERACION
    MOVE "A" TO FA-TIPO
    MOVE 250 TO FA-CUOTA
    MOVE 0.05 TO FA-TASA
    MOVE 1 TO FA-PERIODOS
    CALL "fin-anualidad" USING FA-PARAMS
    MOVE "anticipada de un periodo" TO WS-NOMBRE
    IF FA-CODIGO = FIN-OK AND FA-VALOR-PRESENTE = 250
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF
    .

0400-PRESTAMO.
    INITIALIZE FL-PARAMS
    MOVE "PAGO" TO FL-OPERACION
    MOVE "F" TO FL-METODO
    MOVE 1200 TO FL-CAPITAL
    MOVE 0 TO FL-TASA
    MOVE 12 TO FL-PERIODOS
    CALL "fin-prestamo" USING FL-PARAMS
    MOVE "frances tasa cero" TO WS-NOMBRE
    IF FL-CODIGO = FIN-OK AND FL-CUOTA = 100 AND FL-SALDO-FINAL = 0
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FL-PARAMS
    MOVE "PAGO" TO FL-OPERACION
    MOVE "F" TO FL-METODO
    MOVE 1000 TO FL-CAPITAL
    MOVE 0.05 TO FL-TASA
    MOVE 1 TO FL-PERIODOS
    CALL "fin-prestamo" USING FL-PARAMS
    MOVE "frances un periodo" TO WS-NOMBRE
    IF FL-CODIGO = FIN-OK AND FL-CUOTA = 1050 AND FL-SALDO-FINAL = 0
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FL-PARAMS
    MOVE "PLAN" TO FL-OPERACION
    MOVE "F" TO FL-METODO
    MOVE 12000 TO FL-CAPITAL
    MOVE 0.01 TO FL-TASA
    MOVE 12 TO FL-PERIODOS
    CALL "fin-prestamo" USING FL-PARAMS
    MOVE 0 TO WS-SUMA-CAP
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > FL-FILAS
        COMPUTE WS-SUMA-CAP = WS-SUMA-CAP + FL-CAPITAL-PER(WS-K)
    END-PERFORM
    MOVE "frances cierra el saldo" TO WS-NOMBRE
    IF FL-CODIGO = FIN-OK AND FL-SALDO-FINAL = 0
        AND WS-SUMA-CAP = 12000 AND FL-FILAS = 12
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FL-PARAMS
    MOVE "PLAN" TO FL-OPERACION
    MOVE "G" TO FL-METODO
    MOVE 1200 TO FL-CAPITAL
    MOVE 0.01 TO FL-TASA
    MOVE 12 TO FL-PERIODOS
    CALL "fin-prestamo" USING FL-PARAMS
    MOVE "aleman capital constante" TO WS-NOMBRE
    IF FL-CODIGO = FIN-OK AND FL-CUOTA = 100
        AND FL-INTERES-PER(1) = 12
        AND FL-CUOTA-PER(1) = 112
        AND FL-SALDO-FINAL = 0
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF
    .

0500-VPN-TIR.
    INITIALIZE FT-PARAMS
    MOVE "VPN" TO FT-OPERACION
    MOVE 0 TO FT-TASA
    MOVE 3 TO FT-NUM-FLUJOS
    MOVE -100 TO FT-FLUJO(1)
    MOVE 40 TO FT-FLUJO(2)
    MOVE 60 TO FT-FLUJO(3)
    CALL "fin-vpn-tir" USING FT-PARAMS
    MOVE "VPN a tasa cero" TO WS-NOMBRE
    IF FT-CODIGO = FIN-OK AND FT-VPN = 0
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FT-PARAMS
    MOVE "TIR" TO FT-OPERACION
    MOVE "N" TO FT-ESTRATEGIA
    MOVE 0.10 TO FT-TASA
    MOVE 0.000000001 TO FT-TOLERANCIA
    MOVE 40 TO FT-MAX-ITER
    MOVE 2 TO FT-NUM-FLUJOS
    MOVE -100 TO FT-FLUJO(1)
    MOVE 110 TO FT-FLUJO(2)
    CALL "fin-vpn-tir" USING FT-PARAMS
    MOVE "TIR de un periodo" TO WS-NOMBRE
    IF FT-CODIGO = FIN-OK AND FT-TIR = 0.10
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FT-PARAMS
    MOVE "TIR" TO FT-OPERACION
    MOVE "N" TO FT-ESTRATEGIA
    MOVE 0.10 TO FT-TASA
    MOVE 0.000000001 TO FT-TOLERANCIA
    MOVE 40 TO FT-MAX-ITER
    MOVE 3 TO FT-NUM-FLUJOS
    MOVE 10 TO FT-FLUJO(1)
    MOVE 20 TO FT-FLUJO(2)
    MOVE 30 TO FT-FLUJO(3)
    CALL "fin-vpn-tir" USING FT-PARAMS
    MOVE "TIR sin cambio de signo" TO WS-NOMBRE
    IF FT-CODIGO = FIN-ERR-SIGNO
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF
    .

0600-DEPRECIACION.
    INITIALIZE FD-PARAMS
    MOVE "LIN" TO FD-METODO
    MOVE 1000 TO FD-COSTO
    MOVE 100 TO FD-RESIDUAL
    MOVE 5 TO FD-VIDA
    MOVE 1 TO FD-ANIO
    CALL "fin-depreciacion" USING FD-PARAMS
    MOVE "lineal 180" TO WS-NOMBRE
    IF FD-CODIGO = FIN-OK AND FD-CUOTA = 180 AND FD-VALOR-LIBROS = 820
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FD-PARAMS
    MOVE "DEC" TO FD-METODO
    MOVE 1000 TO FD-COSTO
    MOVE 900 TO FD-RESIDUAL
    MOVE 0.5 TO FD-TASA
    MOVE 5 TO FD-VIDA
    MOVE 1 TO FD-ANIO
    CALL "fin-depreciacion" USING FD-PARAMS
    MOVE "decreciente con piso" TO WS-NOMBRE
    IF FD-CODIGO = FIN-OK AND FD-CUOTA = 100 AND FD-VALOR-LIBROS = 900
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF

    INITIALIZE FD-PARAMS
    MOVE "DSD" TO FD-METODO
    MOVE 10000 TO FD-COSTO
    MOVE 0 TO FD-RESIDUAL
    MOVE 5 TO FD-VIDA
    MOVE 0 TO FD-ANIO
    CALL "fin-depreciacion" USING FD-PARAMS
    MOVE "doble saldo tasa 2/5" TO WS-NOMBRE
    IF FD-CODIGO = FIN-OK AND FD-TASA-USADA = 0.4
        AND FD-CUOTA-PER(1) = 4000
        PERFORM 9000-OK
    ELSE
        PERFORM 9100-FALLO
    END-IF
    .

9000-OK.
    ADD 1 TO WS-OK
    ADD 1 TO WS-N
    .

9100-FALLO.
    ADD 1 TO WS-FALLOS
    ADD 1 TO WS-N
    DISPLAY "FALLO " WS-N " " FUNCTION TRIM(WS-NOMBRE)
    .

END PROGRAM fin-humo.
