>>SOURCE FORMAT FREE
*> Anualidades ordinarias y anticipadas.
IDENTIFICATION DIVISION.
PROGRAM-ID. fin-anualidad IS INITIAL.

ENVIRONMENT DIVISION.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "fin-estado.cpy".
COPY "fin-potencia.cpy".

01 WS-FACTOR                  PIC S9(20)V9(16) COMP-3.
01 WS-BASE                    PIC S9(20)V9(16) COMP-3.
01 WS-UNO-MAS                 PIC S9(20)V9(16) COMP-3.

LINKAGE SECTION.
COPY "fin-anualidad.cpy".

PROCEDURE DIVISION USING FA-PARAMS.
0000-MAIN.
    PERFORM 1000-INICIALIZAR
    MOVE FUNCTION UPPER-CASE(FA-OPERACION) TO FA-OPERACION
    MOVE FUNCTION UPPER-CASE(FA-TIPO) TO FA-TIPO
    EVALUATE FA-OPERACION
        WHEN "PVAN"
            PERFORM 2000-VALOR-PRESENTE
        WHEN "FVAN"
            PERFORM 2100-VALOR-FUTURO
        WHEN "CUOT"
            PERFORM 2200-CUOTA
        WHEN OTHER
            MOVE FIN-ERR-OPERACION TO FA-CODIGO
            MOVE "Operacion desconocida en fin-anualidad" TO FA-MENSAJE
    END-EVALUATE
    GOBACK.

1000-INICIALIZAR.
    MOVE FIN-OK TO FA-CODIGO
    MOVE SPACES TO FA-MENSAJE
    .

2000-VALOR-PRESENTE.
    PERFORM 3000-VALIDAR
    IF FA-CODIGO NOT = FIN-OK
        EXIT PARAGRAPH
    END-IF
    IF FA-TASA = 0 OR WS-FACTOR = 1
        COMPUTE FA-VALOR-PRESENTE ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
            = FA-CUOTA * FA-PERIODOS
            ON SIZE ERROR
                PERFORM 3900-DESBORDAMIENTO
        END-COMPUTE
    ELSE
        IF FA-TIPO = "O"
            COMPUTE FA-VALOR-PRESENTE ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
                = FA-CUOTA * (1 - (1 / WS-FACTOR)) / FA-TASA
                ON SIZE ERROR
                    PERFORM 3900-DESBORDAMIENTO
            END-COMPUTE
        ELSE
            COMPUTE FA-VALOR-PRESENTE ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
                = FA-CUOTA * WS-UNO-MAS * (1 - (1 / WS-FACTOR)) / FA-TASA
                ON SIZE ERROR
                    PERFORM 3900-DESBORDAMIENTO
            END-COMPUTE
        END-IF
    END-IF
    IF FA-CODIGO = FIN-OK
        MOVE "Valor presente de la anualidad" TO FA-MENSAJE
    END-IF
    .

2100-VALOR-FUTURO.
    PERFORM 3000-VALIDAR
    IF FA-CODIGO NOT = FIN-OK
        EXIT PARAGRAPH
    END-IF
    IF FA-TASA = 0 OR WS-FACTOR = 1
        COMPUTE FA-VALOR-FUTURO ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
            = FA-CUOTA * FA-PERIODOS
            ON SIZE ERROR
                PERFORM 3900-DESBORDAMIENTO
        END-COMPUTE
    ELSE
        IF FA-TIPO = "O"
            COMPUTE FA-VALOR-FUTURO ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
                = FA-CUOTA * (WS-FACTOR - 1) / FA-TASA
                ON SIZE ERROR
                    PERFORM 3900-DESBORDAMIENTO
            END-COMPUTE
        ELSE
            COMPUTE FA-VALOR-FUTURO ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
                = FA-CUOTA * WS-UNO-MAS * (WS-FACTOR - 1) / FA-TASA
                ON SIZE ERROR
                    PERFORM 3900-DESBORDAMIENTO
            END-COMPUTE
        END-IF
    END-IF
    IF FA-CODIGO = FIN-OK
        MOVE "Valor futuro de la anualidad" TO FA-MENSAJE
    END-IF
    .

2200-CUOTA.
    PERFORM 3000-VALIDAR
    IF FA-CODIGO NOT = FIN-OK
        EXIT PARAGRAPH
    END-IF
    IF FA-TASA = 0 OR WS-FACTOR = 1
        COMPUTE FA-CUOTA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
            = FA-VALOR-PRESENTE / FA-PERIODOS
            ON SIZE ERROR
                PERFORM 3900-DESBORDAMIENTO
        END-COMPUTE
    ELSE
        IF FA-TIPO = "O"
            COMPUTE FA-CUOTA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
                = FA-VALOR-PRESENTE * FA-TASA * WS-FACTOR
                    / (WS-FACTOR - 1)
                ON SIZE ERROR
                    PERFORM 3900-DESBORDAMIENTO
            END-COMPUTE
        ELSE
            COMPUTE FA-CUOTA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
                = FA-VALOR-PRESENTE * FA-TASA * WS-FACTOR
                    / (WS-UNO-MAS * (WS-FACTOR - 1))
                ON SIZE ERROR
                    PERFORM 3900-DESBORDAMIENTO
            END-COMPUTE
        END-IF
    END-IF
    IF FA-CODIGO = FIN-OK
        MOVE "Cuota de la anualidad" TO FA-MENSAJE
    END-IF
    .

3000-VALIDAR.
    IF FA-TIPO NOT = "O" AND FA-TIPO NOT = "A"
        MOVE FIN-ERR-METODO TO FA-CODIGO
        MOVE "Tipo de anualidad: O ordinaria o A anticipada" TO FA-MENSAJE
        EXIT PARAGRAPH
    END-IF
    IF FA-PERIODOS < 1 OR FA-PERIODOS > FIN-MAX-PERIODOS
        MOVE FIN-ERR-PERIODOS TO FA-CODIGO
        MOVE "Periodos de la anualidad fuera de rango" TO FA-MENSAJE
        EXIT PARAGRAPH
    END-IF
    IF FA-TASA <= -1
        MOVE FIN-ERR-TASA TO FA-CODIGO
        MOVE "Tasa menor o igual que -1" TO FA-MENSAJE
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-UNO-MAS ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = 1 + FA-TASA
    MOVE "POWI" TO FP-OPERACION
    MOVE WS-UNO-MAS TO FP-BASE
    MOVE FA-PERIODOS TO FP-EXPONENTE
    MOVE 0 TO FP-RESULTADO FP-CODIGO
    MOVE SPACES TO FP-MENSAJE
    CALL "fin-potencia" USING FP-PARAMS
        ON EXCEPTION
            MOVE FIN-ERR-ARCHIVO TO FA-CODIGO
            MOVE "No se pudo cargar fin-potencia" TO FA-MENSAJE
            EXIT PARAGRAPH
    END-CALL
    IF FP-CODIGO NOT = FIN-OK
        MOVE FP-CODIGO TO FA-CODIGO
        MOVE FP-MENSAJE TO FA-MENSAJE
        EXIT PARAGRAPH
    END-IF
    MOVE FP-RESULTADO TO WS-FACTOR
    IF WS-FACTOR <= 0
        MOVE FIN-ERR-DESBORDAMIENTO TO FA-CODIGO
        MOVE "Factor de la anualidad no positivo" TO FA-MENSAJE
    END-IF
    .

3900-DESBORDAMIENTO.
    MOVE FIN-ERR-DESBORDAMIENTO TO FA-CODIGO
    MOVE "Desbordamiento en la anualidad" TO FA-MENSAJE
    .

END PROGRAM fin-anualidad.
