>>SOURCE FORMAT FREE
*> VPN y TIR de un proyecto y de un bono de un periodo.
IDENTIFICATION DIVISION.
PROGRAM-ID. demo-tir.

ENVIRONMENT DIVISION.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "fin-vpn-tir.cpy".
01 ED-IMP                     PIC --,---,---,---,--9.9(6).
01 ED-TASA                    PIC -(4)9.9(12).
01 ED-N                       PIC Z(5)9.

PROCEDURE DIVISION.
0000-MAIN.
    PERFORM 1000-PROYECTO
    DISPLAY " "
    PERFORM 2000-BONO
    STOP RUN.

1000-PROYECTO.
    INITIALIZE FT-PARAMS
    MOVE 5 TO FT-NUM-FLUJOS
    MOVE -100000 TO FT-FLUJO(1)
    MOVE 30000 TO FT-FLUJO(2)
    MOVE 35000 TO FT-FLUJO(3)
    MOVE 40000 TO FT-FLUJO(4)
    MOVE 45000 TO FT-FLUJO(5)
    MOVE "VPN" TO FT-OPERACION
    MOVE 0.08 TO FT-TASA
    CALL "fin-vpn-tir" USING FT-PARAMS
    DISPLAY "PROYECTO"
    MOVE 0.08 TO ED-TASA
    DISPLAY "  Tasa de descuento " ED-TASA
    MOVE FT-VPN TO ED-IMP
    DISPLAY "  VPN               " ED-IMP
    MOVE "TIR" TO FT-OPERACION
    MOVE "N" TO FT-ESTRATEGIA
    MOVE 0.10 TO FT-TASA
    MOVE 0.000000001 TO FT-TOLERANCIA
    MOVE 80 TO FT-MAX-ITER
    CALL "fin-vpn-tir" USING FT-PARAMS
    MOVE FT-TIR TO ED-TASA
    DISPLAY "  TIR               " ED-TASA
    DISPLAY "  Metodo            " FT-METODO
    MOVE FT-ITERACIONES TO ED-N
    DISPLAY "  Iteraciones       " ED-N
    MOVE FT-VPN TO ED-IMP
    DISPLAY "  VPN residual      " ED-IMP
    DISPLAY "  Codigo            " FT-CODIGO
    .

2000-BONO.
    INITIALIZE FT-PARAMS
    MOVE "TIR" TO FT-OPERACION
    MOVE "N" TO FT-ESTRATEGIA
    MOVE 0.05 TO FT-TASA
    MOVE 0.000000001 TO FT-TOLERANCIA
    MOVE 40 TO FT-MAX-ITER
    MOVE 2 TO FT-NUM-FLUJOS
    MOVE -1000 TO FT-FLUJO(1)
    MOVE 1100 TO FT-FLUJO(2)
    CALL "fin-vpn-tir" USING FT-PARAMS
    DISPLAY "BONO A UN PERIODO"
    MOVE FT-TIR TO ED-TASA
    DISPLAY "  TIR               " ED-TASA
    MOVE FT-VPN TO ED-IMP
    DISPLAY "  VPN residual      " ED-IMP
    DISPLAY "  Codigo            " FT-CODIGO
    .

END PROGRAM demo-tir.
