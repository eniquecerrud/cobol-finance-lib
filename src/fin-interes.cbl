>>SOURCE FORMAT FREE
*> Interés simple y compuesto, valor presente y futuro, tasas.
IDENTIFICATION DIVISION.
PROGRAM-ID. fin-interes IS INITIAL.

ENVIRONMENT DIVISION.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "fin-estado.cpy".
COPY "fin-potencia.cpy".

01 WS-FACTOR                  PIC S9(20)V9(16) COMP-3.
01 WS-BASE                    PIC S9(20)V9(16) COMP-3.

LINKAGE SECTION.
COPY "fin-interes.cpy".

PROCEDURE DIVISION USING FI-PARAMS.
0000-MAIN.
    PERFORM 1000-INICIALIZAR
    MOVE FUNCTION UPPER-CASE(FI-OPERACION) TO FI-OPERACION
    EVALUATE FI-OPERACION
        WHEN "SIMP"
            PERFORM 2000-SIMPLE
        WHEN "COMP"
            PERFORM 2100-COMPUESTO
        WHEN "VFUT"
            PERFORM 2100-COMPUESTO
        WHEN "VPRE"
            PERFORM 2200-PRESENTE
        WHEN "EFEC"
            PERFORM 2300-EFECTIVA
        WHEN "NOMI"
            PERFORM 2400-NOMINAL
        WHEN OTHER
            MOVE FIN-ERR-OPERACION TO FI-CODIGO
            MOVE "Operacion desconocida en fin-interes" TO FI-MENSAJE
    END-EVALUATE
    GOBACK.

1000-INICIALIZAR.
    MOVE FIN-OK TO FI-CODIGO
    MOVE SPACES TO FI-MENSAJE
    MOVE 0 TO FI-INTERES FI-TASA-SALIDA
    IF FI-OPERACION = "VPRE" OR FI-OPERACION = "vpre"
        MOVE 0 TO FI-VALOR-PRESENTE
    END-IF
    IF FI-OPERACION = "SIMP" OR FI-OPERACION = "simp"
        OR FI-OPERACION = "COMP" OR FI-OPERACION = "comp"
        OR FI-OPERACION = "VFUT" OR FI-OPERACION = "vfut"
        MOVE 0 TO FI-VALOR-FUTURO FI-VALOR-PRESENTE
    END-IF
    .

2000-SIMPLE.
    IF FI-TIEMPO < 0
        MOVE FIN-ERR-PERIODOS TO FI-CODIGO
        MOVE "El tiempo del interes simple es negativo" TO FI-MENSAJE
        EXIT PARAGRAPH
    END-IF
    COMPUTE FI-INTERES ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = FI-CAPITAL * FI-TASA * FI-TIEMPO
        ON SIZE ERROR
            MOVE FIN-ERR-DESBORDAMIENTO TO FI-CODIGO
            MOVE "Desbordamiento en el interes simple" TO FI-MENSAJE
            EXIT PARAGRAPH
    END-COMPUTE
    COMPUTE FI-VALOR-FUTURO ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = FI-CAPITAL + FI-INTERES
        ON SIZE ERROR
            MOVE FIN-ERR-DESBORDAMIENTO TO FI-CODIGO
            MOVE "Desbordamiento en el valor futuro simple" TO FI-MENSAJE
            EXIT PARAGRAPH
    END-COMPUTE
    MOVE "Interes simple" TO FI-MENSAJE
    .

2100-COMPUESTO.
    PERFORM 3000-VALIDAR-TASA-COMPUESTA
    IF FI-CODIGO NOT = FIN-OK
        EXIT PARAGRAPH
    END-IF
    IF FI-PERIODOS > FIN-MAX-EXPONENTE
        MOVE FIN-ERR-PERIODOS TO FI-CODIGO
        MOVE "Periodos fuera de rango" TO FI-MENSAJE
        EXIT PARAGRAPH
    END-IF
    PERFORM 3100-FACTOR
    IF FI-CODIGO NOT = FIN-OK
        EXIT PARAGRAPH
    END-IF
    COMPUTE FI-VALOR-FUTURO ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = FI-CAPITAL * WS-FACTOR
        ON SIZE ERROR
            MOVE FIN-ERR-DESBORDAMIENTO TO FI-CODIGO
            MOVE "Desbordamiento en el valor futuro" TO FI-MENSAJE
            EXIT PARAGRAPH
    END-COMPUTE
    COMPUTE FI-INTERES = FI-VALOR-FUTURO - FI-CAPITAL
    MOVE "Interes compuesto" TO FI-MENSAJE
    .

2200-PRESENTE.
    PERFORM 3000-VALIDAR-TASA-COMPUESTA
    IF FI-CODIGO NOT = FIN-OK
        EXIT PARAGRAPH
    END-IF
    IF FI-PERIODOS > FIN-MAX-EXPONENTE
        MOVE FIN-ERR-PERIODOS TO FI-CODIGO
        MOVE "Periodos fuera de rango" TO FI-MENSAJE
        EXIT PARAGRAPH
    END-IF
    PERFORM 3100-FACTOR
    IF FI-CODIGO NOT = FIN-OK
        EXIT PARAGRAPH
    END-IF
    IF WS-FACTOR = 0
        MOVE FIN-ERR-TASA TO FI-CODIGO
        MOVE "Factor de descuento nulo" TO FI-MENSAJE
        EXIT PARAGRAPH
    END-IF
    COMPUTE FI-VALOR-PRESENTE ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = FI-VALOR-FUTURO / WS-FACTOR
        ON SIZE ERROR
            MOVE FIN-ERR-DESBORDAMIENTO TO FI-CODIGO
            MOVE "Desbordamiento en el valor presente" TO FI-MENSAJE
            EXIT PARAGRAPH
    END-COMPUTE
    MOVE "Valor presente" TO FI-MENSAJE
    .

2300-EFECTIVA.
    IF FI-CAPITALIZACIONES < 1
        OR FI-CAPITALIZACIONES > FIN-MAX-EXPONENTE
        MOVE FIN-ERR-PERIODOS TO FI-CODIGO
        MOVE "Capitalizaciones fuera de rango" TO FI-MENSAJE
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-BASE ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = 1 + (FI-TASA / FI-CAPITALIZACIONES)
        ON SIZE ERROR
            MOVE FIN-ERR-DESBORDAMIENTO TO FI-CODIGO
            MOVE "Desbordamiento al partir la nominal" TO FI-MENSAJE
            EXIT PARAGRAPH
    END-COMPUTE
    IF WS-BASE <= 0
        MOVE FIN-ERR-TASA TO FI-CODIGO
        MOVE "Nominal / m menor o igual que -1" TO FI-MENSAJE
        EXIT PARAGRAPH
    END-IF
    MOVE "POWI" TO FP-OPERACION
    MOVE WS-BASE TO FP-BASE
    MOVE FI-CAPITALIZACIONES TO FP-EXPONENTE
    PERFORM 3200-LLAMAR-POTENCIA
    IF FI-CODIGO NOT = FIN-OK
        EXIT PARAGRAPH
    END-IF
    COMPUTE FI-TASA-SALIDA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = FP-RESULTADO - 1
        ON SIZE ERROR
            MOVE FIN-ERR-DESBORDAMIENTO TO FI-CODIGO
            MOVE "Desbordamiento en la tasa efectiva" TO FI-MENSAJE
            EXIT PARAGRAPH
    END-COMPUTE
    MOVE "Tasa efectiva" TO FI-MENSAJE
    .

2400-NOMINAL.
    IF FI-TASA <= -1
        MOVE FIN-ERR-TASA TO FI-CODIGO
        MOVE "Efectiva menor o igual que -1" TO FI-MENSAJE
        EXIT PARAGRAPH
    END-IF
    IF FI-CAPITALIZACIONES < 1
        OR FI-CAPITALIZACIONES > FIN-MAX-EXPONENTE
        MOVE FIN-ERR-PERIODOS TO FI-CODIGO
        MOVE "Capitalizaciones fuera de rango" TO FI-MENSAJE
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-BASE ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = 1 + FI-TASA
    MOVE "RAIZ" TO FP-OPERACION
    MOVE WS-BASE TO FP-BASE
    MOVE FI-CAPITALIZACIONES TO FP-EXPONENTE
    PERFORM 3200-LLAMAR-POTENCIA
    IF FI-CODIGO NOT = FIN-OK
        EXIT PARAGRAPH
    END-IF
    COMPUTE FI-TASA-SALIDA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = FI-CAPITALIZACIONES * (FP-RESULTADO - 1)
        ON SIZE ERROR
            MOVE FIN-ERR-DESBORDAMIENTO TO FI-CODIGO
            MOVE "Desbordamiento en la tasa nominal" TO FI-MENSAJE
            EXIT PARAGRAPH
    END-COMPUTE
    MOVE "Tasa nominal" TO FI-MENSAJE
    .

3000-VALIDAR-TASA-COMPUESTA.
    IF FI-TASA <= -1
        MOVE FIN-ERR-TASA TO FI-CODIGO
        MOVE "Tasa menor o igual que -1" TO FI-MENSAJE
    END-IF
    .

3100-FACTOR.
    COMPUTE WS-BASE ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = 1 + FI-TASA
    MOVE "POWI" TO FP-OPERACION
    MOVE WS-BASE TO FP-BASE
    MOVE FI-PERIODOS TO FP-EXPONENTE
    PERFORM 3200-LLAMAR-POTENCIA
    IF FP-CODIGO = FIN-OK
        MOVE FP-RESULTADO TO WS-FACTOR
    END-IF
    .

3200-LLAMAR-POTENCIA.
    MOVE 0 TO FP-RESULTADO
    MOVE 0 TO FP-CODIGO
    MOVE SPACES TO FP-MENSAJE
    CALL "fin-potencia" USING FP-PARAMS
        ON EXCEPTION
            MOVE FIN-ERR-ARCHIVO TO FI-CODIGO
            MOVE "No se pudo cargar fin-potencia" TO FI-MENSAJE
            EXIT PARAGRAPH
    END-CALL
    IF FP-CODIGO NOT = FIN-OK
        MOVE FP-CODIGO TO FI-CODIGO
        MOVE FP-MENSAJE TO FI-MENSAJE
    END-IF
    .

END PROGRAM fin-interes.
