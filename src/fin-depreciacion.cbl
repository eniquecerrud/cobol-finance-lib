>>SOURCE FORMAT FREE
*> Depreciación lineal, saldo decreciente y doble saldo.
IDENTIFICATION DIVISION.
PROGRAM-ID. fin-depreciacion IS INITIAL.

ENVIRONMENT DIVISION.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "fin-estado.cpy".

01 WS-TASA                    PIC S9(4)V9(12) COMP-3.
01 WS-CUOTA-BASE              PIC S9(13)V9(6) COMP-3.
01 WS-LIBROS                  PIC S9(13)V9(6) COMP-3.
01 WS-ACUM                    PIC S9(13)V9(6) COMP-3.
01 WS-CUOTA                   PIC S9(13)V9(6) COMP-3.
01 WS-BASE-DEP                PIC S9(13)V9(6) COMP-3.
01 WS-TOPE                    PIC 9(3) COMP-5.
01 WS-K                       PIC 9(3) COMP-5.

LINKAGE SECTION.
COPY "fin-depreciacion.cpy".

PROCEDURE DIVISION USING FD-PARAMS.
0000-MAIN.
    PERFORM 1000-INICIALIZAR
    MOVE FUNCTION UPPER-CASE(FD-METODO) TO FD-METODO
    PERFORM 2000-VALIDAR
    IF FD-CODIGO = FIN-OK
        PERFORM 3000-CUADRO
    END-IF
    GOBACK.

1000-INICIALIZAR.
    MOVE FIN-OK TO FD-CODIGO
    MOVE SPACES TO FD-MENSAJE
    MOVE 0 TO FD-TASA-USADA FD-CUOTA FD-ACUMULADO FD-VALOR-LIBROS FD-FILAS
    .

2000-VALIDAR.
    IF FD-METODO NOT = "LIN"
        AND FD-METODO NOT = "DEC"
        AND FD-METODO NOT = "DSD"
        MOVE FIN-ERR-METODO TO FD-CODIGO
        MOVE "Metodo: LIN, DEC o DSD" TO FD-MENSAJE
        EXIT PARAGRAPH
    END-IF
    IF FD-VIDA < 1 OR FD-VIDA > FIN-MAX-VIDA
        MOVE FIN-ERR-PERIODOS TO FD-CODIGO
        MOVE "Vida util fuera de rango" TO FD-MENSAJE
        EXIT PARAGRAPH
    END-IF
    IF FD-ANIO > FD-VIDA
        MOVE FIN-ERR-PERIODOS TO FD-CODIGO
        MOVE "El anio pedido supera la vida util" TO FD-MENSAJE
        EXIT PARAGRAPH
    END-IF
    IF FD-COSTO < 0 OR FD-RESIDUAL < 0
        MOVE FIN-ERR-ARGUMENTO TO FD-CODIGO
        MOVE "Costo o residual negativo" TO FD-MENSAJE
        EXIT PARAGRAPH
    END-IF
    IF FD-RESIDUAL > FD-COSTO
        MOVE FIN-ERR-ARGUMENTO TO FD-CODIGO
        MOVE "El residual supera el costo" TO FD-MENSAJE
        EXIT PARAGRAPH
    END-IF
    EVALUATE FD-METODO
        WHEN "LIN"
            MOVE 0 TO WS-TASA
            COMPUTE WS-BASE-DEP = FD-COSTO - FD-RESIDUAL
            COMPUTE WS-CUOTA-BASE ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
                = WS-BASE-DEP / FD-VIDA
            MOVE "Depreciacion lineal" TO FD-MENSAJE
        WHEN "DEC"
            IF FD-TASA <= 0
                MOVE FIN-ERR-ARGUMENTO TO FD-CODIGO
                MOVE "La tasa de saldo decreciente debe ser positiva"
                    TO FD-MENSAJE
                EXIT PARAGRAPH
            END-IF
            MOVE FD-TASA TO WS-TASA
            MOVE "Saldo decreciente" TO FD-MENSAJE
        WHEN "DSD"
            COMPUTE WS-TASA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
                = 2 / FD-VIDA
            MOVE "Doble saldo decreciente" TO FD-MENSAJE
    END-EVALUATE
    MOVE WS-TASA TO FD-TASA-USADA
    .

3000-CUADRO.
    IF FD-ANIO = 0
        MOVE FD-VIDA TO WS-TOPE
    ELSE
        MOVE FD-ANIO TO WS-TOPE
    END-IF
    MOVE FD-COSTO TO WS-LIBROS
    MOVE 0 TO WS-ACUM
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-TOPE
        IF FD-METODO = "LIN"
            PERFORM 3100-CUOTA-LINEAL
        ELSE
            PERFORM 3200-CUOTA-DECRECIENTE
        END-IF
        COMPUTE WS-ACUM = WS-ACUM + WS-CUOTA
        COMPUTE WS-LIBROS = WS-LIBROS - WS-CUOTA
        MOVE WS-K TO FD-ANIO-N(WS-K)
        MOVE WS-CUOTA TO FD-CUOTA-PER(WS-K)
        MOVE WS-ACUM TO FD-ACUM-PER(WS-K)
        MOVE WS-LIBROS TO FD-LIBROS-PER(WS-K)
    END-PERFORM
    MOVE WS-TOPE TO FD-FILAS
    IF FD-ANIO = 0
        MOVE WS-ACUM TO FD-CUOTA
    ELSE
        MOVE FD-CUOTA-PER(WS-TOPE) TO FD-CUOTA
    END-IF
    MOVE WS-ACUM TO FD-ACUMULADO
    MOVE WS-LIBROS TO FD-VALOR-LIBROS
    .

3100-CUOTA-LINEAL.
    IF WS-K = FD-VIDA
        COMPUTE WS-CUOTA = WS-LIBROS - FD-RESIDUAL
    ELSE
        MOVE WS-CUOTA-BASE TO WS-CUOTA
        IF WS-LIBROS - WS-CUOTA < FD-RESIDUAL
            COMPUTE WS-CUOTA = WS-LIBROS - FD-RESIDUAL
        END-IF
    END-IF
    IF WS-CUOTA < 0
        MOVE 0 TO WS-CUOTA
    END-IF
    .

3200-CUOTA-DECRECIENTE.
    COMPUTE WS-CUOTA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = WS-LIBROS * WS-TASA
        ON SIZE ERROR
            MOVE FIN-ERR-DESBORDAMIENTO TO FD-CODIGO
            MOVE "Desbordamiento en la depreciacion" TO FD-MENSAJE
            MOVE 0 TO WS-CUOTA
    END-COMPUTE
    IF WS-LIBROS - WS-CUOTA < FD-RESIDUAL
        COMPUTE WS-CUOTA = WS-LIBROS - FD-RESIDUAL
    END-IF
    IF WS-CUOTA < 0
        MOVE 0 TO WS-CUOTA
    END-IF
    .

END PROGRAM fin-depreciacion.
