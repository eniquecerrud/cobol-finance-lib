>>SOURCE FORMAT FREE
*> Cuota y cuadro de amortización francés y alemán.
IDENTIFICATION DIVISION.
PROGRAM-ID. fin-prestamo IS INITIAL.

ENVIRONMENT DIVISION.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "fin-estado.cpy".
COPY "fin-potencia.cpy".

01 WS-FACTOR                  PIC S9(20)V9(16) COMP-3.
01 WS-BASE                    PIC S9(20)V9(16) COMP-3.
01 WS-SALDO                   PIC S9(13)V9(6) COMP-3.
01 WS-INTERES                 PIC S9(13)V9(6) COMP-3.
01 WS-CAPITAL-PER             PIC S9(13)V9(6) COMP-3.
01 WS-PAGO                    PIC S9(13)V9(6) COMP-3.
01 WS-CUOTA-CAP               PIC S9(13)V9(6) COMP-3.
01 WS-PROPUESTA               PIC S9(13)V9(6) COMP-3.
01 WS-K                       PIC 9(5) COMP-5.

LINKAGE SECTION.
COPY "fin-prestamo.cpy".

PROCEDURE DIVISION USING FL-PARAMS.
0000-MAIN.
    PERFORM 1000-INICIALIZAR
    MOVE FUNCTION UPPER-CASE(FL-OPERACION) TO FL-OPERACION
    MOVE FUNCTION UPPER-CASE(FL-METODO) TO FL-METODO
    EVALUATE FL-OPERACION
        WHEN "PAGO"
            PERFORM 2000-CALCULAR
        WHEN "PLAN"
            PERFORM 2000-CALCULAR
        WHEN OTHER
            MOVE FIN-ERR-OPERACION TO FL-CODIGO
            MOVE "Operacion desconocida en fin-prestamo" TO FL-MENSAJE
    END-EVALUATE
    GOBACK.

1000-INICIALIZAR.
    MOVE FIN-OK TO FL-CODIGO
    MOVE SPACES TO FL-MENSAJE
    MOVE 0 TO FL-CUOTA FL-CUOTA-INICIAL FL-CUOTA-FINAL
    MOVE 0 TO FL-TOTAL-INTERES FL-TOTAL-PAGADO FL-SALDO-FINAL FL-FILAS
    .

2000-CALCULAR.
    PERFORM 3000-VALIDAR
    IF FL-CODIGO NOT = FIN-OK
        EXIT PARAGRAPH
    END-IF
    IF FL-CAPITAL = 0
        PERFORM 2100-CAPITAL-CERO
        EXIT PARAGRAPH
    END-IF
    IF FL-METODO = "F"
        PERFORM 3100-CUOTA-FRANCESA
    ELSE
        PERFORM 3200-CUOTA-ALEMANA
    END-IF
    IF FL-CODIGO NOT = FIN-OK
        EXIT PARAGRAPH
    END-IF
    PERFORM 4000-CUADRO
    .

2100-CAPITAL-CERO.
    MOVE 0 TO FL-CUOTA
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > FL-PERIODOS
        MOVE WS-K TO FL-NUMERO(WS-K)
        MOVE 0 TO FL-CUOTA-PER(WS-K)
        MOVE 0 TO FL-INTERES-PER(WS-K)
        MOVE 0 TO FL-CAPITAL-PER(WS-K)
        MOVE 0 TO FL-SALDO-PER(WS-K)
    END-PERFORM
    MOVE FL-PERIODOS TO FL-FILAS
    MOVE 0 TO FL-CUOTA-INICIAL FL-CUOTA-FINAL FL-SALDO-FINAL
    MOVE "Capital cero" TO FL-MENSAJE
    .

3000-VALIDAR.
    IF FL-METODO NOT = "F" AND FL-METODO NOT = "G"
        MOVE FIN-ERR-METODO TO FL-CODIGO
        MOVE "Metodo: F frances o G aleman" TO FL-MENSAJE
        EXIT PARAGRAPH
    END-IF
    IF FL-PERIODOS < 1 OR FL-PERIODOS > FIN-MAX-PERIODOS
        MOVE FIN-ERR-PERIODOS TO FL-CODIGO
        MOVE "Periodos del prestamo fuera de rango" TO FL-MENSAJE
        EXIT PARAGRAPH
    END-IF
    IF FL-CAPITAL < 0
        MOVE FIN-ERR-ARGUMENTO TO FL-CODIGO
        MOVE "El capital del prestamo es negativo" TO FL-MENSAJE
        EXIT PARAGRAPH
    END-IF
    IF FL-TASA <= -1
        MOVE FIN-ERR-TASA TO FL-CODIGO
        MOVE "Tasa menor o igual que -1" TO FL-MENSAJE
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-BASE ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = 1 + FL-TASA
    MOVE "POWI" TO FP-OPERACION
    MOVE WS-BASE TO FP-BASE
    MOVE FL-PERIODOS TO FP-EXPONENTE
    MOVE 0 TO FP-CODIGO FP-RESULTADO
    MOVE SPACES TO FP-MENSAJE
    CALL "fin-potencia" USING FP-PARAMS
        ON EXCEPTION
            MOVE FIN-ERR-ARCHIVO TO FL-CODIGO
            MOVE "No se pudo cargar fin-potencia" TO FL-MENSAJE
            EXIT PARAGRAPH
    END-CALL
    IF FP-CODIGO NOT = FIN-OK
        MOVE FP-CODIGO TO FL-CODIGO
        MOVE FP-MENSAJE TO FL-MENSAJE
        EXIT PARAGRAPH
    END-IF
    MOVE FP-RESULTADO TO WS-FACTOR
    IF WS-FACTOR <= 0
        MOVE FIN-ERR-DESBORDAMIENTO TO FL-CODIGO
        MOVE "Factor del prestamo no positivo" TO FL-MENSAJE
    END-IF
    .

3100-CUOTA-FRANCESA.
    IF FL-TASA = 0 OR WS-FACTOR = 1
        COMPUTE FL-CUOTA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
            = FL-CAPITAL / FL-PERIODOS
            ON SIZE ERROR
                MOVE FIN-ERR-DESBORDAMIENTO TO FL-CODIGO
                MOVE "Desbordamiento en la cuota francesa" TO FL-MENSAJE
        END-COMPUTE
    ELSE
        COMPUTE FL-CUOTA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
            = FL-CAPITAL * FL-TASA * WS-FACTOR / (WS-FACTOR - 1)
            ON SIZE ERROR
                MOVE FIN-ERR-DESBORDAMIENTO TO FL-CODIGO
                MOVE "Desbordamiento en la cuota francesa" TO FL-MENSAJE
        END-COMPUTE
    END-IF
    .

3200-CUOTA-ALEMANA.
    COMPUTE FL-CUOTA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = FL-CAPITAL / FL-PERIODOS
        ON SIZE ERROR
            MOVE FIN-ERR-DESBORDAMIENTO TO FL-CODIGO
            MOVE "Desbordamiento en la cuota alemana" TO FL-MENSAJE
    END-COMPUTE
    MOVE FL-CUOTA TO WS-CUOTA-CAP
    .

4000-CUADRO.
    MOVE FL-CAPITAL TO WS-SALDO
    MOVE 0 TO FL-TOTAL-INTERES FL-TOTAL-PAGADO
    IF FL-METODO = "G"
        MOVE FL-CUOTA TO WS-CUOTA-CAP
    END-IF
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > FL-PERIODOS
        COMPUTE WS-INTERES ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
            = WS-SALDO * FL-TASA
            ON SIZE ERROR
                MOVE FIN-ERR-DESBORDAMIENTO TO FL-CODIGO
                MOVE "Desbordamiento en el interes del periodo" TO FL-MENSAJE
                MOVE 0 TO FL-FILAS
                EXIT PARAGRAPH
        END-COMPUTE
        IF FL-METODO = "F"
            PERFORM 4100-FILA-FRANCESA
        ELSE
            PERFORM 4200-FILA-ALEMANA
        END-IF
        COMPUTE WS-SALDO = WS-SALDO - WS-CAPITAL-PER
        MOVE WS-K TO FL-NUMERO(WS-K)
        MOVE WS-PAGO TO FL-CUOTA-PER(WS-K)
        MOVE WS-INTERES TO FL-INTERES-PER(WS-K)
        MOVE WS-CAPITAL-PER TO FL-CAPITAL-PER(WS-K)
        MOVE WS-SALDO TO FL-SALDO-PER(WS-K)
        COMPUTE FL-TOTAL-INTERES = FL-TOTAL-INTERES + WS-INTERES
        COMPUTE FL-TOTAL-PAGADO = FL-TOTAL-PAGADO + WS-PAGO
        IF WS-K = 1
            MOVE WS-PAGO TO FL-CUOTA-INICIAL
        END-IF
        IF WS-K = FL-PERIODOS
            MOVE WS-PAGO TO FL-CUOTA-FINAL
        END-IF
    END-PERFORM
    MOVE WS-SALDO TO FL-SALDO-FINAL
    MOVE FL-PERIODOS TO FL-FILAS
    IF FL-METODO = "F"
        MOVE "Cuadro frances" TO FL-MENSAJE
    ELSE
        MOVE "Cuadro aleman" TO FL-MENSAJE
    END-IF
    .

4100-FILA-FRANCESA.
    IF WS-K = FL-PERIODOS
        MOVE WS-SALDO TO WS-CAPITAL-PER
        COMPUTE WS-PAGO = WS-CAPITAL-PER + WS-INTERES
    ELSE
        COMPUTE WS-PROPUESTA = FL-CUOTA - WS-INTERES
        IF WS-PROPUESTA > WS-SALDO
            MOVE WS-SALDO TO WS-CAPITAL-PER
            COMPUTE WS-PAGO = WS-CAPITAL-PER + WS-INTERES
        ELSE
            MOVE WS-PROPUESTA TO WS-CAPITAL-PER
            MOVE FL-CUOTA TO WS-PAGO
        END-IF
    END-IF
    .

4200-FILA-ALEMANA.
    IF WS-K = FL-PERIODOS OR WS-CUOTA-CAP > WS-SALDO
        MOVE WS-SALDO TO WS-CAPITAL-PER
    ELSE
        MOVE WS-CUOTA-CAP TO WS-CAPITAL-PER
    END-IF
    COMPUTE WS-PAGO = WS-CAPITAL-PER + WS-INTERES
    .

END PROGRAM fin-prestamo.
