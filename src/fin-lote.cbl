>>SOURCE FORMAT FREE
*> Lee un lote de préstamos, flujos, anualidades y depreciaciones
*> y escribe un informe de texto más un CSV.
IDENTIFICATION DIVISION.
PROGRAM-ID. fin-lote.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ENTRADA ASSIGN TO WS-NOM-ENT
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS-ENT.
    SELECT INFORME ASSIGN TO WS-NOM-TXT
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS-TXT.
    SELECT SALIDA-CSV ASSIGN TO WS-NOM-CSV
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS-CSV.

DATA DIVISION.
FILE SECTION.
FD ENTRADA.
01 REG-ENTRADA                PIC X(16000).
FD INFORME.
01 REG-TXT                    PIC X(220).
FD SALIDA-CSV.
01 REG-CSV                    PIC X(500).

WORKING-STORAGE SECTION.
COPY "fin-estado.cpy".
COPY "fin-prestamo.cpy".
COPY "fin-vpn-tir.cpy".
COPY "fin-anualidad.cpy".
COPY "fin-depreciacion.cpy".

01 WS-NOM-ENT                 PIC X(512).
01 WS-NOM-TXT                 PIC X(512).
01 WS-NOM-CSV                 PIC X(512).
01 WS-FS-ENT                  PIC XX.
01 WS-FS-TXT                  PIC XX.
01 WS-FS-CSV                  PIC XX.
01 WS-NARGS                   PIC 9(4).
01 WS-EOF                     PIC X VALUE "N".
01 WS-LINEA                   PIC X(16000).
01 WS-C1                      PIC X(16000).
01 WS-C2                      PIC X(16000).
01 WS-C3                      PIC X(16000).
01 WS-C4                      PIC X(16000).
01 WS-C5                      PIC X(16000).
01 WS-C6                      PIC X(16000).
01 WS-C7                      PIC X(16000).
01 WS-ID                      PIC X(40).
01 WS-TIPO                    PIC X(16).
01 WS-MODO                    PIC X(4).
01 WS-TEXTO                   PIC X(80).
01 WS-TOKEN                   PIC X(80).
01 WS-LISTA                   PIC X(16000).
01 WS-NUM                     PIC S9(18)V9(12) COMP-3.
01 WS-NUM-OK                  PIC X.
01 WS-TASA-ANUAL              PIC S9(4)V9(12) COMP-3.
01 WS-VPN-GUARDADO            PIC S9(13)V9(6) COMP-3.
01 WS-VALOR-AN                PIC S9(13)V9(6) COMP-3.
01 WS-M                       PIC 9(5) COMP-5.
01 WS-TIEMPO                  PIC 9(5) COMP-5.
01 WS-PTR                     PIC 9(5) COMP-5.
01 WS-LEN                     PIC 9(5) COMP-5.
01 WS-K                       PIC 9(5) COMP-5.
01 WS-LEIDOS                  PIC 9(5) VALUE 0.
01 WS-ERRORES                 PIC 9(5) VALUE 0.
01 WS-COD                     PIC 99.
01 WS-MENSAJE                 PIC X(80).
01 ED-PER                     PIC ZZZZ9.
01 ED-IMP                     PIC --,---,---,---,--9.9(6).
01 ED-IMP2                    PIC --,---,---,---,--9.9(6).
01 ED-IMP3                    PIC --,---,---,---,--9.9(6).
01 ED-IMP4                    PIC --,---,---,---,--9.9(6).
01 ED-TASA                    PIC -(4)9.9(12).
01 ED-CSV                     PIC -(13)9.9(6).
01 ED-CSV-T                   PIC -(4)9.9(12).
01 ED-ENT                     PIC Z(5)9.
01 CSV-TIPO                   PIC X(16).
01 CSV-ID                     PIC X(40).
01 CSV-CONCEPTO               PIC X(24).
01 CSV-N                      PIC X(12).
01 CSV-V1                     PIC X(40).
01 CSV-V2                     PIC X(40).
01 CSV-V3                     PIC X(40).
01 CSV-V4                     PIC X(40).
01 CSV-V5                     PIC X(40).
01 CSV-COD                    PIC 99.

PROCEDURE DIVISION.
0000-MAIN.
    PERFORM 1000-ARGUMENTOS
    PERFORM 1100-ABRIR
    PERFORM 1200-CABECERAS
    PERFORM UNTIL WS-EOF = "S"
        MOVE SPACES TO REG-ENTRADA
        READ ENTRADA
            AT END
                MOVE "S" TO WS-EOF
            NOT AT END
                MOVE REG-ENTRADA TO WS-LINEA
                PERFORM 2000-LINEA
        END-READ
    END-PERFORM
    PERFORM 1300-CIERRE
    CLOSE ENTRADA INFORME SALIDA-CSV
    IF WS-ERRORES = 0
        MOVE 0 TO RETURN-CODE
    ELSE
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

1000-ARGUMENTOS.
    ACCEPT WS-NARGS FROM ARGUMENT-NUMBER
    IF WS-NARGS < 3
        DISPLAY "Uso: fin-lote ENTRADA INFORME.txt INFORME.csv" UPON SYSERR
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    MOVE 1 TO WS-NARGS
    DISPLAY WS-NARGS UPON ARGUMENT-NUMBER
    ACCEPT WS-NOM-ENT FROM ARGUMENT-VALUE
    MOVE 2 TO WS-NARGS
    DISPLAY WS-NARGS UPON ARGUMENT-NUMBER
    ACCEPT WS-NOM-TXT FROM ARGUMENT-VALUE
    MOVE 3 TO WS-NARGS
    DISPLAY WS-NARGS UPON ARGUMENT-NUMBER
    ACCEPT WS-NOM-CSV FROM ARGUMENT-VALUE
    .

1100-ABRIR.
    OPEN INPUT ENTRADA
    IF WS-FS-ENT NOT = "00"
        DISPLAY "No se pudo abrir la entrada" UPON SYSERR
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    OPEN OUTPUT INFORME
    IF WS-FS-TXT NOT = "00"
        DISPLAY "No se pudo crear el informe" UPON SYSERR
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    OPEN OUTPUT SALIDA-CSV
    IF WS-FS-CSV NOT = "00"
        DISPLAY "No se pudo crear el CSV" UPON SYSERR
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    .

1200-CABECERAS.
    MOVE "tipo,id,concepto,n,v1,v2,v3,v4,v5,codigo" TO REG-CSV
    WRITE REG-CSV
    PERFORM 8000-LINEA-DOBLE
    MOVE "MATEMATICAS FINANCIERAS — INFORME DE LOTE" TO REG-TXT
    WRITE REG-TXT
    MOVE SPACES TO REG-TXT
    STRING "Entrada: " FUNCTION TRIM(WS-NOM-ENT) DELIMITED BY SIZE
        INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE "Importes a 6 decimales. Tasas en forma decimal." TO REG-TXT
    WRITE REG-TXT
    MOVE "Redondeo NEAREST-AWAY-FROM-ZERO." TO REG-TXT
    WRITE REG-TXT
    PERFORM 8000-LINEA-DOBLE
    .

1300-CIERRE.
    PERFORM 8000-LINEA-DOBLE
    MOVE SPACES TO REG-TXT
    MOVE WS-LEIDOS TO ED-ENT
    STRING "Registros procesados: " FUNCTION TRIM(ED-ENT)
        DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE SPACES TO REG-TXT
    MOVE WS-ERRORES TO ED-ENT
    STRING "Registros con error:  " FUNCTION TRIM(ED-ENT)
        DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    PERFORM 8000-LINEA-DOBLE
    .

2000-LINEA.
    INSPECT WS-LINEA REPLACING ALL X"0D" BY SPACE
    MOVE FUNCTION TRIM(WS-LINEA) TO WS-LINEA
    IF WS-LINEA = SPACES OR WS-LINEA(1:1) = "#"
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-LEIDOS
    MOVE SPACES TO WS-C1 WS-C2 WS-C3 WS-C4 WS-C5 WS-C6 WS-C7
    UNSTRING WS-LINEA DELIMITED BY "|"
        INTO WS-C1 WS-C2 WS-C3 WS-C4 WS-C5 WS-C6 WS-C7
    END-UNSTRING
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(WS-C1)) TO WS-TIPO
    MOVE FUNCTION TRIM(WS-C2) TO WS-ID
    EVALUATE WS-TIPO
        WHEN "PRESTAMO"
            PERFORM 3000-PRESTAMO
        WHEN "FLUJO"
            PERFORM 4000-FLUJO
        WHEN "ANUALIDAD"
            PERFORM 5000-ANUALIDAD
        WHEN "DEPRECIACION"
            PERFORM 6000-DEPRECIACION
        WHEN OTHER
            MOVE FIN-ERR-OPERACION TO WS-COD
            MOVE "Tipo de registro desconocido" TO WS-MENSAJE
            PERFORM 7900-ERROR
    END-EVALUATE
    .

3000-PRESTAMO.
    INITIALIZE FL-PARAMS
    MOVE "PLAN" TO FL-OPERACION
    MOVE WS-C3 TO WS-TEXTO
    PERFORM 9000-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 7910-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FL-CAPITAL ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C4 TO WS-TEXTO
    PERFORM 9000-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 7910-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-TASA-ANUAL ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C5 TO WS-TEXTO
    PERFORM 9010-ENTERO
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    IF WS-NUM < 1 OR WS-NUM > 365
        MOVE FIN-ERR-PERIODOS TO WS-COD
        MOVE "Periodos por ano fuera de rango" TO WS-MENSAJE
        PERFORM 7900-ERROR
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO WS-M
    MOVE WS-C6 TO WS-TEXTO
    PERFORM 9010-ENTERO
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO FL-PERIODOS
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(WS-C7)) TO FL-METODO
    COMPUTE FL-TASA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = WS-TASA-ANUAL / WS-M
    CALL "fin-prestamo" USING FL-PARAMS
    IF FL-CODIGO NOT = FIN-OK
        MOVE FL-CODIGO TO WS-COD
        MOVE FL-MENSAJE TO WS-MENSAJE
        PERFORM 7900-ERROR
        EXIT PARAGRAPH
    END-IF
    PERFORM 3100-INFORME-PRESTAMO
    .

3100-INFORME-PRESTAMO.
    MOVE SPACES TO REG-TXT
    STRING "PRESTAMO  " FUNCTION TRIM(WS-ID) DELIMITED BY SIZE
        INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    IF FL-METODO = "F"
        MOVE "  Metodo ............ Frances (cuota fija)" TO REG-TXT
    ELSE
        MOVE "  Metodo ............ Aleman (capital constante)" TO REG-TXT
    END-IF
    WRITE REG-TXT
    MOVE FL-CAPITAL TO ED-IMP
    MOVE SPACES TO REG-TXT
    STRING "  Capital ........... " ED-IMP DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE WS-TASA-ANUAL TO ED-TASA
    MOVE SPACES TO REG-TXT
    STRING "  Tasa anual ........ " ED-TASA DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE WS-M TO ED-ENT
    MOVE SPACES TO REG-TXT
    STRING "  Periodos por ano .. " FUNCTION TRIM(ED-ENT)
        DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE FL-TASA TO ED-TASA
    MOVE SPACES TO REG-TXT
    STRING "  Tasa periodica .... " ED-TASA DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE FL-PERIODOS TO ED-ENT
    MOVE SPACES TO REG-TXT
    STRING "  Plazo ............. " FUNCTION TRIM(ED-ENT)
        DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE FL-CUOTA TO ED-IMP
    MOVE SPACES TO REG-TXT
    IF FL-METODO = "F"
        STRING "  Cuota regular ..... " ED-IMP DELIMITED BY SIZE
            INTO REG-TXT
        END-STRING
    ELSE
        STRING "  Capital constante . " ED-IMP DELIMITED BY SIZE
            INTO REG-TXT
        END-STRING
    END-IF
    WRITE REG-TXT
    MOVE SPACES TO REG-TXT
    WRITE REG-TXT
    MOVE "   Per.                     Cuota                   Interes              Amortizacion                     Saldo"
        TO REG-TXT
    WRITE REG-TXT
    MOVE "  ----- ------------------------- ------------------------- ------------------------- -------------------------"
        TO REG-TXT
    WRITE REG-TXT
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > FL-FILAS
        MOVE FL-NUMERO(WS-K) TO ED-PER
        MOVE FL-CUOTA-PER(WS-K) TO ED-IMP
        MOVE FL-INTERES-PER(WS-K) TO ED-IMP2
        MOVE FL-CAPITAL-PER(WS-K) TO ED-IMP3
        MOVE FL-SALDO-PER(WS-K) TO ED-IMP4
        MOVE SPACES TO REG-TXT
        STRING "  " ED-PER " " ED-IMP " " ED-IMP2 " " ED-IMP3 " " ED-IMP4
            DELIMITED BY SIZE INTO REG-TXT
        END-STRING
        WRITE REG-TXT
        PERFORM 3200-CSV-PERIODO
    END-PERFORM
    MOVE SPACES TO REG-TXT
    WRITE REG-TXT
    MOVE FL-TOTAL-INTERES TO ED-IMP
    MOVE SPACES TO REG-TXT
    STRING "  Interes total ..... " ED-IMP DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE FL-TOTAL-PAGADO TO ED-IMP
    MOVE SPACES TO REG-TXT
    STRING "  Total pagado ...... " ED-IMP DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE FL-SALDO-FINAL TO ED-IMP
    MOVE SPACES TO REG-TXT
    STRING "  Saldo final ....... " ED-IMP DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    PERFORM 8000-LINEA
    MOVE "prestamo" TO CSV-TIPO
    MOVE WS-ID TO CSV-ID
    MOVE "resumen" TO CSV-CONCEPTO
    MOVE FL-PERIODOS TO ED-ENT
    MOVE FUNCTION TRIM(ED-ENT) TO CSV-N
    MOVE FL-CUOTA TO ED-CSV
    MOVE FUNCTION TRIM(ED-CSV) TO CSV-V1
    MOVE FL-TOTAL-INTERES TO ED-CSV
    MOVE FUNCTION TRIM(ED-CSV) TO CSV-V2
    MOVE FL-TOTAL-PAGADO TO ED-CSV
    MOVE FUNCTION TRIM(ED-CSV) TO CSV-V3
    MOVE FL-SALDO-FINAL TO ED-CSV
    MOVE FUNCTION TRIM(ED-CSV) TO CSV-V4
    MOVE FL-TASA TO ED-CSV-T
    MOVE FUNCTION TRIM(ED-CSV-T) TO CSV-V5
    MOVE FL-CODIGO TO CSV-COD
    PERFORM 8100-CSV
    .

3200-CSV-PERIODO.
    MOVE "prestamo" TO CSV-TIPO
    MOVE WS-ID TO CSV-ID
    MOVE "periodo" TO CSV-CONCEPTO
    MOVE FL-NUMERO(WS-K) TO ED-ENT
    MOVE FUNCTION TRIM(ED-ENT) TO CSV-N
    MOVE FL-CUOTA-PER(WS-K) TO ED-CSV
    MOVE FUNCTION TRIM(ED-CSV) TO CSV-V1
    MOVE FL-INTERES-PER(WS-K) TO ED-CSV
    MOVE FUNCTION TRIM(ED-CSV) TO CSV-V2
    MOVE FL-CAPITAL-PER(WS-K) TO ED-CSV
    MOVE FUNCTION TRIM(ED-CSV) TO CSV-V3
    MOVE FL-SALDO-PER(WS-K) TO ED-CSV
    MOVE FUNCTION TRIM(ED-CSV) TO CSV-V4
    MOVE SPACES TO CSV-V5
    MOVE 0 TO CSV-COD
    PERFORM 8100-CSV
    .

4000-FLUJO.
    INITIALIZE FT-PARAMS
    MOVE WS-C3 TO WS-TEXTO
    PERFORM 9000-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 7910-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FT-TASA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C4 TO WS-TEXTO
    PERFORM 9000-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 7910-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FT-TOLERANCIA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C5 TO WS-TEXTO
    PERFORM 9010-ENTERO
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO FT-MAX-ITER
    MOVE WS-C6 TO WS-LISTA
    PERFORM 4100-FLUJOS
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE "VPN" TO FT-OPERACION
    CALL "fin-vpn-tir" USING FT-PARAMS
    IF FT-CODIGO NOT = FIN-OK
        MOVE FT-CODIGO TO WS-COD
        MOVE FT-MENSAJE TO WS-MENSAJE
        PERFORM 7900-ERROR
        EXIT PARAGRAPH
    END-IF
    MOVE FT-VPN TO ED-IMP
    MOVE FT-VPN TO WS-VPN-GUARDADO
    MOVE "TIR" TO FT-OPERACION
    MOVE "N" TO FT-ESTRATEGIA
    CALL "fin-vpn-tir" USING FT-PARAMS
    PERFORM 4200-INFORME-FLUJO
    .

4100-FLUJOS.
    MOVE 0 TO FT-NUM-FLUJOS
    MOVE FUNCTION TRIM(WS-LISTA) TO WS-LISTA
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-LISTA))
    IF WS-LEN = 0
        MOVE "N" TO WS-NUM-OK
        MOVE FIN-ERR-SERIE TO WS-COD
        MOVE "Serie de flujos vacia" TO WS-MENSAJE
        PERFORM 7900-ERROR
        EXIT PARAGRAPH
    END-IF
    MOVE 1 TO WS-PTR
    MOVE "S" TO WS-NUM-OK
    PERFORM UNTIL WS-PTR > WS-LEN
        MOVE SPACES TO WS-TOKEN
        UNSTRING WS-LISTA DELIMITED BY ";"
            INTO WS-TOKEN
            WITH POINTER WS-PTR
        END-UNSTRING
        IF FUNCTION TRIM(WS-TOKEN) NOT = SPACES
            ADD 1 TO FT-NUM-FLUJOS
            IF FT-NUM-FLUJOS > FIN-MAX-PERIODOS
                MOVE "N" TO WS-NUM-OK
                MOVE FIN-ERR-SERIE TO WS-COD
                MOVE "Serie de flujos demasiado larga" TO WS-MENSAJE
                PERFORM 7900-ERROR
                EXIT PARAGRAPH
            END-IF
            MOVE WS-TOKEN TO WS-TEXTO
            PERFORM 9000-NUMERO
            IF WS-NUM-OK NOT = "S"
                PERFORM 7910-ARGUMENTO
                EXIT PARAGRAPH
            END-IF
            COMPUTE FT-FLUJO(FT-NUM-FLUJOS)
                ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
        END-IF
    END-PERFORM
    .

4200-INFORME-FLUJO.
    MOVE SPACES TO REG-TXT
    STRING "FLUJOS  " FUNCTION TRIM(WS-ID) DELIMITED BY SIZE
        INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE FT-TASA TO ED-TASA
    MOVE SPACES TO REG-TXT
    STRING "  Tasa de descuento . " ED-TASA DELIMITED BY SIZE
        INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE SPACES TO REG-TXT
    STRING "  VPN ............... " ED-IMP DELIMITED BY SIZE
        INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    IF FT-CODIGO = FIN-OK
        MOVE FT-TIR TO ED-TASA
        MOVE SPACES TO REG-TXT
        STRING "  TIR ............... " ED-TASA
            "   metodo " FT-METODO DELIMITED BY SIZE
            INTO REG-TXT
        END-STRING
        WRITE REG-TXT
    ELSE
        MOVE SPACES TO REG-TXT
        STRING "  TIR ............... " FUNCTION TRIM(FT-MENSAJE)
            DELIMITED BY SIZE INTO REG-TXT
        END-STRING
        WRITE REG-TXT
        ADD 1 TO WS-ERRORES
    END-IF
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > FT-NUM-FLUJOS
        MOVE FT-FLUJO(WS-K) TO ED-IMP
        SUBTRACT 1 FROM WS-K GIVING WS-TIEMPO
        MOVE WS-TIEMPO TO ED-ENT
        MOVE SPACES TO REG-TXT
        STRING "  t=" FUNCTION TRIM(ED-ENT) "  " ED-IMP
            DELIMITED BY SIZE INTO REG-TXT
        END-STRING
        WRITE REG-TXT
        MOVE "flujo" TO CSV-TIPO
        MOVE WS-ID TO CSV-ID
        MOVE "flujo" TO CSV-CONCEPTO
        MOVE FUNCTION TRIM(ED-ENT) TO CSV-N
        MOVE FT-FLUJO(WS-K) TO ED-CSV
        MOVE FUNCTION TRIM(ED-CSV) TO CSV-V1
        MOVE SPACES TO CSV-V2 CSV-V3 CSV-V4 CSV-V5
        MOVE 0 TO CSV-COD
        PERFORM 8100-CSV
    END-PERFORM
    PERFORM 8000-LINEA
    MOVE "flujo" TO CSV-TIPO
    MOVE WS-ID TO CSV-ID
    MOVE "vpn" TO CSV-CONCEPTO
    MOVE FT-NUM-FLUJOS TO ED-ENT
    MOVE FUNCTION TRIM(ED-ENT) TO CSV-N
    MOVE WS-VPN-GUARDADO TO ED-CSV
    MOVE FUNCTION TRIM(ED-CSV) TO CSV-V1
    MOVE SPACES TO CSV-V2 CSV-V3 CSV-V4 CSV-V5
    MOVE 0 TO CSV-COD
    PERFORM 8100-CSV
    MOVE "tir" TO CSV-CONCEPTO
    IF FT-CODIGO = FIN-OK
        MOVE FT-TIR TO ED-CSV-T
        MOVE FUNCTION TRIM(ED-CSV-T) TO CSV-V1
        MOVE FT-ITERACIONES TO ED-ENT
        MOVE FUNCTION TRIM(ED-ENT) TO CSV-V2
        MOVE FT-METODO TO CSV-V3
        MOVE SPACES TO CSV-V4 CSV-V5
        MOVE 0 TO CSV-COD
    ELSE
        MOVE FUNCTION TRIM(FT-MENSAJE) TO CSV-V1
        MOVE SPACES TO CSV-V2 CSV-V3 CSV-V4 CSV-V5
        MOVE FT-CODIGO TO CSV-COD
    END-IF
    PERFORM 8100-CSV
    .

5000-ANUALIDAD.
    INITIALIZE FA-PARAMS
    MOVE WS-C3 TO WS-TEXTO
    PERFORM 9000-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 7910-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FA-CUOTA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C4 TO WS-TEXTO
    PERFORM 9000-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 7910-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FA-TASA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C5 TO WS-TEXTO
    PERFORM 9010-ENTERO
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO FA-PERIODOS
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(WS-C6)) TO FA-TIPO
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(WS-C7)) TO WS-MODO
    IF WS-MODO = "FV"
        MOVE "FVAN" TO FA-OPERACION
    ELSE
        IF WS-MODO = "PV"
            MOVE "PVAN" TO FA-OPERACION
        ELSE
            MOVE FIN-ERR-OPERACION TO WS-COD
            MOVE "Modo de anualidad: PV o FV" TO WS-MENSAJE
            PERFORM 7900-ERROR
            EXIT PARAGRAPH
        END-IF
    END-IF
    CALL "fin-anualidad" USING FA-PARAMS
    IF FA-CODIGO NOT = FIN-OK
        MOVE FA-CODIGO TO WS-COD
        MOVE FA-MENSAJE TO WS-MENSAJE
        PERFORM 7900-ERROR
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO REG-TXT
    STRING "ANUALIDAD  " FUNCTION TRIM(WS-ID) DELIMITED BY SIZE
        INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE FA-CUOTA TO ED-IMP
    MOVE SPACES TO REG-TXT
    STRING "  Cuota ............. " ED-IMP DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE FA-TASA TO ED-TASA
    MOVE SPACES TO REG-TXT
    STRING "  Tasa periodica .... " ED-TASA DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    IF FA-TIPO = "A"
        MOVE "  Modalidad ......... anticipada" TO REG-TXT
    ELSE
        MOVE "  Modalidad ......... ordinaria" TO REG-TXT
    END-IF
    WRITE REG-TXT
    IF WS-MODO = "FV"
        MOVE FA-VALOR-FUTURO TO WS-VALOR-AN
        MOVE "valor_futuro" TO CSV-CONCEPTO
    ELSE
        MOVE FA-VALOR-PRESENTE TO WS-VALOR-AN
        MOVE "valor_presente" TO CSV-CONCEPTO
    END-IF
    MOVE WS-VALOR-AN TO ED-IMP
    MOVE SPACES TO REG-TXT
    STRING "  Valor ............. " ED-IMP DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    PERFORM 8000-LINEA
    MOVE "anualidad" TO CSV-TIPO
    MOVE WS-ID TO CSV-ID
    MOVE FA-PERIODOS TO ED-ENT
    MOVE FUNCTION TRIM(ED-ENT) TO CSV-N
    MOVE WS-VALOR-AN TO ED-CSV
    MOVE FUNCTION TRIM(ED-CSV) TO CSV-V1
    MOVE FA-CUOTA TO ED-CSV
    MOVE FUNCTION TRIM(ED-CSV) TO CSV-V2
    MOVE FA-TASA TO ED-CSV-T
    MOVE FUNCTION TRIM(ED-CSV-T) TO CSV-V3
    MOVE FA-TIPO TO CSV-V4
    MOVE WS-MODO TO CSV-V5
    MOVE 0 TO CSV-COD
    PERFORM 8100-CSV
    .

6000-DEPRECIACION.
    INITIALIZE FD-PARAMS
    MOVE WS-C3 TO WS-TEXTO
    PERFORM 9000-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 7910-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FD-COSTO ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C4 TO WS-TEXTO
    PERFORM 9000-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 7910-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FD-RESIDUAL ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C5 TO WS-TEXTO
    PERFORM 9010-ENTERO
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO FD-VIDA
    MOVE WS-C6 TO WS-TEXTO
    PERFORM 9000-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 7910-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FD-TASA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(WS-C7)) TO FD-METODO
    MOVE 0 TO FD-ANIO
    CALL "fin-depreciacion" USING FD-PARAMS
    IF FD-CODIGO NOT = FIN-OK
        MOVE FD-CODIGO TO WS-COD
        MOVE FD-MENSAJE TO WS-MENSAJE
        PERFORM 7900-ERROR
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO REG-TXT
    STRING "DEPRECIACION  " FUNCTION TRIM(WS-ID) "  " FD-METODO
        DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE FD-COSTO TO ED-IMP
    MOVE SPACES TO REG-TXT
    STRING "  Costo ............. " ED-IMP DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE FD-RESIDUAL TO ED-IMP
    MOVE SPACES TO REG-TXT
    STRING "  Residual .......... " ED-IMP DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE FD-TASA-USADA TO ED-TASA
    MOVE SPACES TO REG-TXT
    STRING "  Tasa usada ........ " ED-TASA DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    MOVE "   Anio                     Cuota                 Acumulado           Valor en libros"
        TO REG-TXT
    WRITE REG-TXT
    MOVE "  ----- ------------------------- ------------------------- -------------------------"
        TO REG-TXT
    WRITE REG-TXT
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > FD-FILAS
        MOVE FD-ANIO-N(WS-K) TO ED-PER
        MOVE FD-CUOTA-PER(WS-K) TO ED-IMP
        MOVE FD-ACUM-PER(WS-K) TO ED-IMP2
        MOVE FD-LIBROS-PER(WS-K) TO ED-IMP3
        MOVE SPACES TO REG-TXT
        STRING "  " ED-PER " " ED-IMP " " ED-IMP2 " " ED-IMP3
            DELIMITED BY SIZE INTO REG-TXT
        END-STRING
        WRITE REG-TXT
        MOVE "depreciacion" TO CSV-TIPO
        MOVE WS-ID TO CSV-ID
        MOVE "periodo" TO CSV-CONCEPTO
        MOVE FD-ANIO-N(WS-K) TO ED-ENT
        MOVE FUNCTION TRIM(ED-ENT) TO CSV-N
        MOVE FD-CUOTA-PER(WS-K) TO ED-CSV
        MOVE FUNCTION TRIM(ED-CSV) TO CSV-V1
        MOVE FD-ACUM-PER(WS-K) TO ED-CSV
        MOVE FUNCTION TRIM(ED-CSV) TO CSV-V2
        MOVE FD-LIBROS-PER(WS-K) TO ED-CSV
        MOVE FUNCTION TRIM(ED-CSV) TO CSV-V3
        MOVE SPACES TO CSV-V4 CSV-V5
        MOVE 0 TO CSV-COD
        PERFORM 8100-CSV
    END-PERFORM
    PERFORM 8000-LINEA
    .

7900-ERROR.
    ADD 1 TO WS-ERRORES
    MOVE SPACES TO REG-TXT
    STRING "ERROR  " FUNCTION TRIM(WS-ID) "  " WS-COD "  "
        FUNCTION TRIM(WS-MENSAJE) DELIMITED BY SIZE INTO REG-TXT
    END-STRING
    WRITE REG-TXT
    PERFORM 8000-LINEA
    MOVE "error" TO CSV-TIPO
    MOVE WS-ID TO CSV-ID
    MOVE FUNCTION TRIM(WS-MENSAJE) TO CSV-CONCEPTO
    MOVE "0" TO CSV-N
    MOVE SPACES TO CSV-V1 CSV-V2 CSV-V3 CSV-V4 CSV-V5
    MOVE WS-COD TO CSV-COD
    PERFORM 8100-CSV
    .

7910-ARGUMENTO.
    MOVE FIN-ERR-ARGUMENTO TO WS-COD
    MOVE "Argumento numerico invalido" TO WS-MENSAJE
    PERFORM 7900-ERROR
    .

8000-LINEA.
    MOVE "------------------------------------------------------------------------"
        TO REG-TXT
    WRITE REG-TXT
    .

8000-LINEA-DOBLE.
    MOVE "========================================================================"
        TO REG-TXT
    WRITE REG-TXT
    .

8100-CSV.
    MOVE SPACES TO REG-CSV
    STRING
        FUNCTION TRIM(CSV-TIPO) DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        FUNCTION TRIM(CSV-ID) DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        FUNCTION TRIM(CSV-CONCEPTO) DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        FUNCTION TRIM(CSV-N) DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        FUNCTION TRIM(CSV-V1) DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        FUNCTION TRIM(CSV-V2) DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        FUNCTION TRIM(CSV-V3) DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        FUNCTION TRIM(CSV-V4) DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        FUNCTION TRIM(CSV-V5) DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        CSV-COD DELIMITED BY SIZE
        INTO REG-CSV
    END-STRING
    WRITE REG-CSV
    .

9000-NUMERO.
    MOVE FUNCTION TRIM(WS-TEXTO) TO WS-TEXTO
    IF WS-TEXTO = SPACES
        OR FUNCTION TEST-NUMVAL(WS-TEXTO) NOT = 0
        MOVE "N" TO WS-NUM-OK
    ELSE
        COMPUTE WS-NUM ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
            = FUNCTION NUMVAL(WS-TEXTO)
        MOVE "S" TO WS-NUM-OK
    END-IF
    .

9010-ENTERO.
    PERFORM 9000-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 7910-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    IF WS-NUM NOT = FUNCTION INTEGER-PART(WS-NUM)
        OR WS-NUM < 0 OR WS-NUM > 99999
        MOVE "N" TO WS-NUM-OK
        MOVE FIN-ERR-PERIODOS TO WS-COD
        MOVE "Entero fuera de rango" TO WS-MENSAJE
        PERFORM 7900-ERROR
    END-IF
    .

END PROGRAM fin-lote.
