>>SOURCE FORMAT FREE
*> Interfaz de texto sobre los subprogramas. Una orden por línea.
*> Los resultados salen por stdout como codigo|campo|campo.
IDENTIFICATION DIVISION.
PROGRAM-ID. fin-calc.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ENTRADA ASSIGN TO WS-NOMBRE
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS.

DATA DIVISION.
FILE SECTION.
FD ENTRADA.
01 REG-ENTRADA                 PIC X(16000).

WORKING-STORAGE SECTION.
COPY "fin-estado.cpy".
COPY "fin-potencia.cpy".
COPY "fin-interes.cpy".
COPY "fin-anualidad.cpy".
COPY "fin-prestamo.cpy".
COPY "fin-vpn-tir.cpy".
COPY "fin-depreciacion.cpy".

01 WS-NOMBRE                   PIC X(512).
01 WS-FS                       PIC XX.
01 WS-NARGS                    PIC 9(4).
01 WS-EOF                      PIC X VALUE "N".
01 WS-LINEA                    PIC X(16000).
01 WS-C1                       PIC X(16000).
01 WS-C2                       PIC X(16000).
01 WS-C3                       PIC X(16000).
01 WS-C4                       PIC X(16000).
01 WS-C5                       PIC X(16000).
01 WS-C6                       PIC X(16000).
01 WS-C7                       PIC X(16000).
01 WS-C8                       PIC X(16000).
01 WS-OP                       PIC X(8).
01 WS-TEXTO                    PIC X(80).
01 WS-TOKEN                    PIC X(80).
01 WS-LISTA                    PIC X(16000).
01 WS-NUM                      PIC S9(18)V9(12) COMP-3.
01 WS-NUM-OK                   PIC X.
01 WS-COD                      PIC 99.
01 WS-MENSAJE                  PIC X(80).
01 WS-PTR                      PIC 9(5) COMP-5.
01 WS-LEN                      PIC 9(5) COMP-5.
01 WS-FILA                     PIC 9(5) COMP-5.
01 ED-6                        PIC -(13)9.9(6).
01 ED-6B                       PIC -(13)9.9(6).
01 ED-6C                       PIC -(13)9.9(6).
01 ED-6D                       PIC -(13)9.9(6).
01 ED-6E                       PIC -(13)9.9(6).
01 ED-6F                       PIC -(13)9.9(6).
01 ED-12                       PIC -(4)9.9(12).
01 ED-12B                      PIC -(4)9.9(12).
01 ED-16                       PIC -(20)9.9(16).
01 ED-ENT                      PIC Z(4)9.

PROCEDURE DIVISION.
0000-MAIN.
    PERFORM 1000-ARGUMENTOS
    OPEN INPUT ENTRADA
    IF WS-FS NOT = "00"
        DISPLAY "07|No se pudo abrir la entrada" UPON SYSERR
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    PERFORM UNTIL WS-EOF = "S"
        MOVE SPACES TO REG-ENTRADA
        READ ENTRADA
            AT END
                MOVE "S" TO WS-EOF
            NOT AT END
                MOVE REG-ENTRADA TO WS-LINEA
                PERFORM 2000-PROCESAR-LINEA
        END-READ
    END-PERFORM
    CLOSE ENTRADA
    MOVE 0 TO RETURN-CODE
    STOP RUN.

1000-ARGUMENTOS.
    ACCEPT WS-NARGS FROM ARGUMENT-NUMBER
    IF WS-NARGS < 1
        DISPLAY "Uso: fin-calc ORDENES.txt" UPON SYSERR
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    MOVE 1 TO WS-NARGS
    DISPLAY WS-NARGS UPON ARGUMENT-NUMBER
    ACCEPT WS-NOMBRE FROM ARGUMENT-VALUE
    .

2000-PROCESAR-LINEA.
    INSPECT WS-LINEA REPLACING ALL X"0D" BY SPACE
    MOVE FUNCTION TRIM(WS-LINEA) TO WS-LINEA
    IF WS-LINEA = SPACES
        EXIT PARAGRAPH
    END-IF
    IF WS-LINEA(1:1) = "#"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-C1 WS-C2 WS-C3 WS-C4 WS-C5 WS-C6 WS-C7 WS-C8
    UNSTRING WS-LINEA DELIMITED BY "|"
        INTO WS-C1 WS-C2 WS-C3 WS-C4 WS-C5 WS-C6 WS-C7 WS-C8
    END-UNSTRING
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(WS-C1)) TO WS-OP
    EVALUATE WS-OP
        WHEN "SIMP"
            PERFORM 3000-SIMP
        WHEN "COMP"
            PERFORM 3100-COMP
        WHEN "VPRE"
            PERFORM 3200-VPRE
        WHEN "VFUT"
            PERFORM 3300-VFUT
        WHEN "EFEC"
            PERFORM 3400-EFEC
        WHEN "NOMI"
            PERFORM 3500-NOMI
        WHEN "PVAN"
            PERFORM 4000-PVAN
        WHEN "FVAN"
            PERFORM 4100-FVAN
        WHEN "CUOT"
            PERFORM 4200-CUOT
        WHEN "PAGO"
            PERFORM 5000-PAGO
        WHEN "PLAN"
            PERFORM 5000-PAGO
        WHEN "FILA"
            PERFORM 5100-FILA
        WHEN "VPN"
            PERFORM 6000-VPN
        WHEN "TIR"
            PERFORM 6100-TIR
        WHEN "POT"
            PERFORM 7000-POT
        WHEN "RAIZ"
            PERFORM 7100-RAIZ
        WHEN "LIN"
            PERFORM 8000-LIN
        WHEN "DEC"
            PERFORM 8100-DEC
        WHEN "DSD"
            PERFORM 8200-DSD
        WHEN OTHER
            MOVE FIN-ERR-OPERACION TO WS-COD
            MOVE "Operacion desconocida" TO WS-MENSAJE
            PERFORM 9900-ERROR
    END-EVALUATE
    .

3000-SIMP.
    INITIALIZE FI-PARAMS
    MOVE "SIMP" TO FI-OPERACION
    MOVE WS-C2 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FI-CAPITAL ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C3 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FI-TASA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C4 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FI-TIEMPO ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    CALL "fin-interes" USING FI-PARAMS
    IF FI-CODIGO NOT = FIN-OK
        MOVE FI-CODIGO TO WS-COD
        MOVE FI-MENSAJE TO WS-MENSAJE
        PERFORM 9900-ERROR
    ELSE
        MOVE FI-CODIGO TO WS-COD
        MOVE FI-INTERES TO ED-6
        MOVE FI-VALOR-FUTURO TO ED-6B
        DISPLAY WS-COD "|" FUNCTION TRIM(ED-6) "|" FUNCTION TRIM(ED-6B)
    END-IF
    .

3100-COMP.
    PERFORM 9200-INTERES-DISCRETO
    MOVE "COMP" TO FI-OPERACION
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    CALL "fin-interes" USING FI-PARAMS
    PERFORM 9300-MOSTRAR-FUTURO
    .

3200-VPRE.
    INITIALIZE FI-PARAMS
    MOVE "VPRE" TO FI-OPERACION
    MOVE WS-C2 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FI-VALOR-FUTURO ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    PERFORM 9400-TASA-Y-PERIODOS
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    CALL "fin-interes" USING FI-PARAMS
    IF FI-CODIGO NOT = FIN-OK
        MOVE FI-CODIGO TO WS-COD
        MOVE FI-MENSAJE TO WS-MENSAJE
        PERFORM 9900-ERROR
    ELSE
        MOVE FI-CODIGO TO WS-COD
        MOVE FI-VALOR-PRESENTE TO ED-6
        DISPLAY WS-COD "|" FUNCTION TRIM(ED-6)
    END-IF
    .

3300-VFUT.
    PERFORM 9200-INTERES-DISCRETO
    MOVE "VFUT" TO FI-OPERACION
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    CALL "fin-interes" USING FI-PARAMS
    PERFORM 9300-MOSTRAR-FUTURO
    .

3400-EFEC.
    PERFORM 9500-TASA-Y-M
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE "EFEC" TO FI-OPERACION
    CALL "fin-interes" USING FI-PARAMS
    PERFORM 9600-MOSTRAR-TASA
    .

3500-NOMI.
    PERFORM 9500-TASA-Y-M
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE "NOMI" TO FI-OPERACION
    CALL "fin-interes" USING FI-PARAMS
    PERFORM 9600-MOSTRAR-TASA
    .

4000-PVAN.
    PERFORM 9700-BASE-ANUALIDAD
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE "PVAN" TO FA-OPERACION
    CALL "fin-anualidad" USING FA-PARAMS
    IF FA-CODIGO NOT = FIN-OK
        MOVE FA-CODIGO TO WS-COD
        MOVE FA-MENSAJE TO WS-MENSAJE
        PERFORM 9900-ERROR
    ELSE
        MOVE FA-CODIGO TO WS-COD
        MOVE FA-VALOR-PRESENTE TO ED-6
        DISPLAY WS-COD "|" FUNCTION TRIM(ED-6)
    END-IF
    .

4100-FVAN.
    PERFORM 9700-BASE-ANUALIDAD
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE "FVAN" TO FA-OPERACION
    CALL "fin-anualidad" USING FA-PARAMS
    IF FA-CODIGO NOT = FIN-OK
        MOVE FA-CODIGO TO WS-COD
        MOVE FA-MENSAJE TO WS-MENSAJE
        PERFORM 9900-ERROR
    ELSE
        MOVE FA-CODIGO TO WS-COD
        MOVE FA-VALOR-FUTURO TO ED-6
        DISPLAY WS-COD "|" FUNCTION TRIM(ED-6)
    END-IF
    .

4200-CUOT.
    INITIALIZE FA-PARAMS
    MOVE "CUOT" TO FA-OPERACION
    MOVE WS-C2 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FA-VALOR-PRESENTE ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
        = WS-NUM
    MOVE WS-C3 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FA-TASA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C4 TO WS-TEXTO
    PERFORM 9110-TOMAR-PERIODOS
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO FA-PERIODOS
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(WS-C5)) TO FA-TIPO
    CALL "fin-anualidad" USING FA-PARAMS
    IF FA-CODIGO NOT = FIN-OK
        MOVE FA-CODIGO TO WS-COD
        MOVE FA-MENSAJE TO WS-MENSAJE
        PERFORM 9900-ERROR
    ELSE
        MOVE FA-CODIGO TO WS-COD
        MOVE FA-CUOTA TO ED-6
        DISPLAY WS-COD "|" FUNCTION TRIM(ED-6)
    END-IF
    .

5000-PAGO.
    PERFORM 5010-BASE-PRESTAMO
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    CALL "fin-prestamo" USING FL-PARAMS
    IF FL-CODIGO NOT = FIN-OK
        MOVE FL-CODIGO TO WS-COD
        MOVE FL-MENSAJE TO WS-MENSAJE
        PERFORM 9900-ERROR
    ELSE
        MOVE FL-CODIGO TO WS-COD
        MOVE FL-CUOTA TO ED-6
        MOVE FL-CUOTA-INICIAL TO ED-6B
        MOVE FL-CUOTA-FINAL TO ED-6C
        MOVE FL-TOTAL-INTERES TO ED-6D
        MOVE FL-TOTAL-PAGADO TO ED-6E
        MOVE FL-SALDO-FINAL TO ED-6F
        DISPLAY WS-COD "|" FUNCTION TRIM(ED-6)
            "|" FUNCTION TRIM(ED-6B)
            "|" FUNCTION TRIM(ED-6C)
            "|" FUNCTION TRIM(ED-6D)
            "|" FUNCTION TRIM(ED-6E)
            "|" FUNCTION TRIM(ED-6F)
    END-IF
    .

5100-FILA.
    PERFORM 5010-BASE-PRESTAMO
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-C6 TO WS-TEXTO
    PERFORM 9110-TOMAR-PERIODOS
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO WS-FILA
    CALL "fin-prestamo" USING FL-PARAMS
    IF FL-CODIGO NOT = FIN-OK
        MOVE FL-CODIGO TO WS-COD
        MOVE FL-MENSAJE TO WS-MENSAJE
        PERFORM 9900-ERROR
        EXIT PARAGRAPH
    END-IF
    IF WS-FILA < 1 OR WS-FILA > FL-FILAS
        MOVE FIN-ERR-PERIODOS TO WS-COD
        MOVE "Periodo fuera del cuadro" TO WS-MENSAJE
        PERFORM 9900-ERROR
        EXIT PARAGRAPH
    END-IF
    MOVE FL-CODIGO TO WS-COD
    MOVE FL-CUOTA-PER(WS-FILA) TO ED-6
    MOVE FL-INTERES-PER(WS-FILA) TO ED-6B
    MOVE FL-CAPITAL-PER(WS-FILA) TO ED-6C
    MOVE FL-SALDO-PER(WS-FILA) TO ED-6D
    DISPLAY WS-COD "|" FUNCTION TRIM(ED-6)
        "|" FUNCTION TRIM(ED-6B)
        "|" FUNCTION TRIM(ED-6C)
        "|" FUNCTION TRIM(ED-6D)
    .

5010-BASE-PRESTAMO.
    INITIALIZE FL-PARAMS
    MOVE "PLAN" TO FL-OPERACION
    MOVE WS-C2 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FL-CAPITAL ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C3 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FL-TASA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C4 TO WS-TEXTO
    PERFORM 9110-TOMAR-PERIODOS
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO FL-PERIODOS
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(WS-C5)) TO FL-METODO
    .

6000-VPN.
    INITIALIZE FT-PARAMS
    MOVE "VPN" TO FT-OPERACION
    MOVE WS-C2 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FT-TASA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C3 TO WS-LISTA
    PERFORM 6120-CARGAR-FLUJOS
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    CALL "fin-vpn-tir" USING FT-PARAMS
    IF FT-CODIGO NOT = FIN-OK
        MOVE FT-CODIGO TO WS-COD
        MOVE FT-MENSAJE TO WS-MENSAJE
        PERFORM 9900-ERROR
    ELSE
        MOVE FT-CODIGO TO WS-COD
        MOVE FT-VPN TO ED-6
        DISPLAY WS-COD "|" FUNCTION TRIM(ED-6)
    END-IF
    .

6100-TIR.
    INITIALIZE FT-PARAMS
    MOVE "TIR" TO FT-OPERACION
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(WS-C2)) TO FT-ESTRATEGIA
    MOVE WS-C3 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FT-TASA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C4 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FT-TOLERANCIA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C5 TO WS-TEXTO
    PERFORM 9110-TOMAR-PERIODOS
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO FT-MAX-ITER
    MOVE WS-C6 TO WS-LISTA
    PERFORM 6120-CARGAR-FLUJOS
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    CALL "fin-vpn-tir" USING FT-PARAMS
    IF FT-CODIGO NOT = FIN-OK
        MOVE FT-CODIGO TO WS-COD
        MOVE FT-MENSAJE TO WS-MENSAJE
        PERFORM 9900-ERROR
    ELSE
        MOVE FT-CODIGO TO WS-COD
        MOVE FT-TIR TO ED-12
        MOVE FT-VPN TO ED-6
        MOVE FT-ITERACIONES TO ED-ENT
        DISPLAY WS-COD "|" FUNCTION TRIM(ED-12)
            "|" FUNCTION TRIM(ED-6)
            "|" FUNCTION TRIM(ED-ENT)
            "|" FT-METODO
    END-IF
    .

6120-CARGAR-FLUJOS.
    MOVE 0 TO FT-NUM-FLUJOS
    MOVE FUNCTION TRIM(WS-LISTA) TO WS-LISTA
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-LISTA))
    IF WS-LEN = 0
        MOVE "N" TO WS-NUM-OK
        MOVE FIN-ERR-SERIE TO WS-COD
        MOVE "Serie de flujos vacia" TO WS-MENSAJE
        PERFORM 9900-ERROR
        EXIT PARAGRAPH
    END-IF
    MOVE 1 TO WS-PTR
    MOVE "S" TO WS-NUM-OK
    PERFORM UNTIL WS-PTR > WS-LEN
        MOVE SPACES TO WS-TOKEN
        UNSTRING WS-LISTA DELIMITED BY ";"
            INTO WS-TOKEN
            WITH POINTER WS-PTR
        END-UNSTRING
        IF FUNCTION TRIM(WS-TOKEN) NOT = SPACES
            ADD 1 TO FT-NUM-FLUJOS
            IF FT-NUM-FLUJOS > FIN-MAX-PERIODOS
                MOVE "N" TO WS-NUM-OK
                MOVE FIN-ERR-SERIE TO WS-COD
                MOVE "Serie de flujos demasiado larga" TO WS-MENSAJE
                PERFORM 9900-ERROR
                EXIT PARAGRAPH
            END-IF
            MOVE WS-TOKEN TO WS-TEXTO
            PERFORM 9100-TOMAR-NUMERO
            IF WS-NUM-OK NOT = "S"
                PERFORM 9800-ARGUMENTO
                EXIT PARAGRAPH
            END-IF
            COMPUTE FT-FLUJO(FT-NUM-FLUJOS)
                ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
        END-IF
    END-PERFORM
    IF FT-NUM-FLUJOS = 0
        MOVE "N" TO WS-NUM-OK
        MOVE FIN-ERR-SERIE TO WS-COD
        MOVE "Serie de flujos vacia" TO WS-MENSAJE
        PERFORM 9900-ERROR
    END-IF
    .

7000-POT.
    INITIALIZE FP-PARAMS
    MOVE "POWI" TO FP-OPERACION
    PERFORM 7200-BASE-Y-EXP
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    CALL "fin-potencia" USING FP-PARAMS
    PERFORM 7300-MOSTRAR-POTENCIA
    .

7100-RAIZ.
    INITIALIZE FP-PARAMS
    MOVE "RAIZ" TO FP-OPERACION
    PERFORM 7200-BASE-Y-EXP
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    CALL "fin-potencia" USING FP-PARAMS
    PERFORM 7300-MOSTRAR-POTENCIA
    .

7200-BASE-Y-EXP.
    MOVE WS-C2 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FP-BASE ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C3 TO WS-TEXTO
    PERFORM 9110-TOMAR-EXPONENTE
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO FP-EXPONENTE
    .

7300-MOSTRAR-POTENCIA.
    IF FP-CODIGO NOT = FIN-OK
        MOVE FP-CODIGO TO WS-COD
        MOVE FP-MENSAJE TO WS-MENSAJE
        PERFORM 9900-ERROR
    ELSE
        MOVE FP-CODIGO TO WS-COD
        MOVE FP-RESULTADO TO ED-16
        DISPLAY WS-COD "|" FUNCTION TRIM(ED-16)
    END-IF
    .

8000-LIN.
    PERFORM 8300-BASE-DEP
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE "LIN" TO FD-METODO
    MOVE 0 TO FD-TASA
    CALL "fin-depreciacion" USING FD-PARAMS
    PERFORM 8400-MOSTRAR-DEP
    .

8100-DEC.
    PERFORM 8300-BASE-DEP
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-C5 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FD-TASA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C6 TO WS-TEXTO
    PERFORM 9110-TOMAR-PERIODOS
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO FD-ANIO
    MOVE "DEC" TO FD-METODO
    CALL "fin-depreciacion" USING FD-PARAMS
    PERFORM 8400-MOSTRAR-DEP
    .

8200-DSD.
    PERFORM 8300-BASE-DEP
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE "DSD" TO FD-METODO
    CALL "fin-depreciacion" USING FD-PARAMS
    PERFORM 8400-MOSTRAR-DEP
    .

8300-BASE-DEP.
    INITIALIZE FD-PARAMS
    MOVE WS-C2 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FD-COSTO ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C3 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FD-RESIDUAL ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C4 TO WS-TEXTO
    PERFORM 9110-TOMAR-PERIODOS
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO FD-VIDA
    IF WS-OP = "DEC"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-C5 TO WS-TEXTO
    PERFORM 9110-TOMAR-PERIODOS
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO FD-ANIO
    .

8400-MOSTRAR-DEP.
    IF FD-CODIGO NOT = FIN-OK
        MOVE FD-CODIGO TO WS-COD
        MOVE FD-MENSAJE TO WS-MENSAJE
        PERFORM 9900-ERROR
    ELSE
        MOVE FD-CODIGO TO WS-COD
        MOVE FD-CUOTA TO ED-6
        MOVE FD-ACUMULADO TO ED-6B
        MOVE FD-VALOR-LIBROS TO ED-6C
        MOVE FD-TASA-USADA TO ED-12
        DISPLAY WS-COD "|" FUNCTION TRIM(ED-6)
            "|" FUNCTION TRIM(ED-6B)
            "|" FUNCTION TRIM(ED-6C)
            "|" FUNCTION TRIM(ED-12)
    END-IF
    .

9100-TOMAR-NUMERO.
    MOVE FUNCTION TRIM(WS-TEXTO) TO WS-TEXTO
    IF WS-TEXTO = SPACES
        MOVE "N" TO WS-NUM-OK
        EXIT PARAGRAPH
    END-IF
    IF FUNCTION TEST-NUMVAL(WS-TEXTO) = 0
        COMPUTE WS-NUM ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO
            = FUNCTION NUMVAL(WS-TEXTO)
        MOVE "S" TO WS-NUM-OK
    ELSE
        MOVE "N" TO WS-NUM-OK
    END-IF
    .

9110-TOMAR-PERIODOS.
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    IF WS-NUM NOT = FUNCTION INTEGER-PART(WS-NUM)
        OR WS-NUM < 0
        OR WS-NUM > 99999
        MOVE "N" TO WS-NUM-OK
        MOVE FIN-ERR-PERIODOS TO WS-COD
        MOVE "El entero esta fuera de rango o tiene decimales"
            TO WS-MENSAJE
        PERFORM 9900-ERROR
    END-IF
    .

9110-TOMAR-EXPONENTE.
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    IF WS-NUM NOT = FUNCTION INTEGER-PART(WS-NUM)
        OR WS-NUM < -99999
        OR WS-NUM > 99999
        MOVE "N" TO WS-NUM-OK
        MOVE FIN-ERR-PERIODOS TO WS-COD
        MOVE "Exponente no entero o fuera de rango" TO WS-MENSAJE
        PERFORM 9900-ERROR
    END-IF
    .

9200-INTERES-DISCRETO.
    INITIALIZE FI-PARAMS
    MOVE WS-C2 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FI-CAPITAL ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    PERFORM 9400-TASA-Y-PERIODOS
    .

9300-MOSTRAR-FUTURO.
    IF FI-CODIGO NOT = FIN-OK
        MOVE FI-CODIGO TO WS-COD
        MOVE FI-MENSAJE TO WS-MENSAJE
        PERFORM 9900-ERROR
    ELSE
        MOVE FI-CODIGO TO WS-COD
        MOVE FI-VALOR-FUTURO TO ED-6
        MOVE FI-INTERES TO ED-6B
        DISPLAY WS-COD "|" FUNCTION TRIM(ED-6) "|" FUNCTION TRIM(ED-6B)
    END-IF
    .

9400-TASA-Y-PERIODOS.
    MOVE WS-C3 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FI-TASA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C4 TO WS-TEXTO
    PERFORM 9110-TOMAR-PERIODOS
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO FI-PERIODOS
    .

9500-TASA-Y-M.
    INITIALIZE FI-PARAMS
    MOVE WS-C2 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FI-TASA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C3 TO WS-TEXTO
    PERFORM 9110-TOMAR-PERIODOS
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO FI-CAPITALIZACIONES
    .

9600-MOSTRAR-TASA.
    IF FI-CODIGO NOT = FIN-OK
        MOVE FI-CODIGO TO WS-COD
        MOVE FI-MENSAJE TO WS-MENSAJE
        PERFORM 9900-ERROR
    ELSE
        MOVE FI-CODIGO TO WS-COD
        MOVE FI-TASA-SALIDA TO ED-12
        DISPLAY WS-COD "|" FUNCTION TRIM(ED-12)
    END-IF
    .

9700-BASE-ANUALIDAD.
    INITIALIZE FA-PARAMS
    MOVE WS-C2 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FA-CUOTA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C3 TO WS-TEXTO
    PERFORM 9100-TOMAR-NUMERO
    IF WS-NUM-OK NOT = "S"
        PERFORM 9800-ARGUMENTO
        EXIT PARAGRAPH
    END-IF
    COMPUTE FA-TASA ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = WS-NUM
    MOVE WS-C4 TO WS-TEXTO
    PERFORM 9110-TOMAR-PERIODOS
    IF WS-NUM-OK NOT = "S"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NUM TO FA-PERIODOS
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(WS-C5)) TO FA-TIPO
    .

9800-ARGUMENTO.
    MOVE FIN-ERR-ARGUMENTO TO WS-COD
    MOVE "Argumento numerico invalido" TO WS-MENSAJE
    PERFORM 9900-ERROR
    .

9900-ERROR.
    DISPLAY WS-COD "|" FUNCTION TRIM(WS-MENSAJE)
    .

END PROGRAM fin-calc.
